{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jonathanmalkin-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-03-18",
  // Production is served only from the first-party custom domain. Disable the
  // public workers.dev and per-version preview surfaces.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    // builtwithjon.com, the former primary address, is served by the redirect
    // worker in redirect-worker/, which sends every page here.
    { "pattern": "opendoorlearningai.com", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist",
    // Unknown paths get the site 404 page with a 404 status.
    "not_found_handling": "404-page",
    // Route protocol/API paths and retirement redirects through the worker
    // before static assets can serve an old generated page.
    "run_worker_first": [
      "/api/subscribe",
      "/api/contact",
      "/api/scorecard-report",
      "/api/event",
      "/hidden-profit-review*",
      "/kits*",
      "/knowledge-os-proof*",
      "/masterclass*",
      "/construction*",
      "/materials*",
      // Open Door Learning rebrand retirements, 2026-10-06. Exact paths for the
      // /ai-assistant hub and Claude Code page so kept /ai-assistant/cowork/
      // and /ai-assistant/course/ files still serve straight from assets.
      "/principles*",
      "/process*",
      "/dispositions*",
      "/use-cases*",
      "/scorecard*",
      "/tools*",
      "/jules*",
      "/ai-assistant",
      "/ai-assistant/",
      "/ai-assistant/claude-code",
      "/ai-assistant/claude-code/",
      "/ai-assistant-workshop*"
    ]
  },
  "vars": {
    "SITE_ORIGIN": "https://opendoorlearningai.com",
    // Keep in sync with Base.astro REQUIRED. The dashboard widget is Managed,
    // scoped to opendoorlearningai.com and builtwithjon.com, and the Worker has TURNSTILE_SECRET_KEY.
    "TURNSTILE_ENABLED": "true",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEJkiadExu7m9ULG",
    "SENDER_FROM": "Open Door Learning <jonathan@builtwithjon.com>",
    // Sender is the sole website email provider. Marketing campaigns must target
    // consent:confirmed, never All Subscribers or a source/offer group alone.
    "SENDER_CAPTURE_ENABLED": "true",
    "SENDER_SENDS_ENABLED": "true",
    "FORM_RATE_LIMITS_ENABLED": "true",
    "FORM_RATE_LIMIT_IP_HOURLY": "20",
    "QR_RATE_LIMIT_IP_HOURLY": "60",
    "FORM_RATE_LIMIT_EMAIL_DAILY": "5",
    "FORM_RATE_LIMIT_GLOBAL_DAILY": "100",
    "SENDER_GROUP_IDS": "{\"consent:pending\":\"er5RX2\",\"consent:confirmed\":\"dw5mZr\",\"source:newsletter\":\"ax5v9l\",\"offer:hidden-profit-review\":\"dy5rM6\",\"asset:invoice-chase-kit\":\"az5K9q\",\"asset:follow-up-swipe-file\":\"aAoPA9\",\"asset:leak-calculator\":\"dBpLQQ\",\"asset:starter-kit-cowork\":\"bDr9P6\",\"offer:email-course\":\"eEv9GW\",\"source:scorecard\":\"dGx5gK\",\"community:ai-club\":\"aKBZmG\",\"source:direct\":\"av5MOg\"}"
  },
  "kv_namespaces": [
    { "binding": "SUBSCRIBE_DEDUPE", "id": "8707fb62aa5147b68f6fae18b437a26a" },
    // Durable first-party lead store. Records carry PII and a 2-year TTL, so it
    // stays separate from the salted-hash, 24h-TTL SUBSCRIBE_DEDUPE namespace.
    { "binding": "LEADS", "id": "1c1200a02c9045539e7abcce0a4f74eb" }
  ],
  "analytics_engine_datasets": [
    { "binding": "SITE_EVENTS", "dataset": "site_events" }
  ]
}
