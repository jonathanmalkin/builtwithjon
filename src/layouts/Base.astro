---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EmailCapture from '../components/EmailCapture.astro';
import SEOHead from '../components/SEOHead.astro';
import JsonLd from '../components/JsonLd.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  schema?: Record<string, unknown>;
  noindex?: boolean;
  hideFooter?: boolean;
  bare?: boolean;
}

const {
  title,
  description,
  image,
  article,
  publishedTime,
  modifiedTime,
  schema,
  noindex,
  hideFooter = false,
  bare = false,
} = Astro.props;

const pageTitle = title === 'Jonathan Malkin'
  ? title
  : `${title} | Jonathan Malkin`;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Jonathan Malkin" href="/rss.xml" />
    <title>{pageTitle}</title>
    <SEOHead
      title={pageTitle}
      description={description}
      image={image}
      article={article}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      noindex={noindex}
    />
    {schema && <JsonLd schema={schema} />}
    <!-- Cloudflare Web Analytics is injected at the edge through Automatic Setup. -->
  </head>
  <body class={bare ? 'bare' : undefined}>
    <script is:inline>
(function () {
  var attribution = '';
  var storageKey = 'bwj_attribution';
  var maxAge = 30 * 24 * 60 * 60 * 1000;
  var fields = [
    ['utm_source', 's'], ['utm_medium', 'm'], ['utm_campaign', 'c'],
    ['utm_content', 'ct'], ['utm_term', 't'], ['src', 'src'],
    ['ref', 'ref'], ['gclid', 'g']
  ];

  function clean(value) {
    return String(value || '').replace(/[^A-Za-z0-9_\-|=.%+ ]/g, '').trim();
  }

  try {
    var stored = localStorage.getItem(storageKey) || '';
    var separator = stored.indexOf('|');
    var expiresAt = separator > 0 ? Number(stored.slice(0, separator)) : 0;
    if (expiresAt > Date.now()) attribution = clean(stored.slice(separator + 1)).slice(0, 240);
    else if (stored) localStorage.removeItem(storageKey);

    var params = new URLSearchParams(location.search);
    var parts = [];
    fields.forEach(function (field) {
      var value = clean(params.get(field[0]));
      if (value) parts.push(field[1] + '=' + value);
    });
    if (parts.length && !attribution) {
      attribution = parts.join('|').slice(0, 240);
      localStorage.setItem(storageKey, String(Date.now() + maxAge) + '|' + attribution);
    }
  } catch (err) {}

  function injectAttribution(root) {
    var scope = root && root.querySelectorAll ? root : document;
    scope.querySelectorAll('form[action^="/api/"]').forEach(function (form) {
      var input = form.querySelector('input[name="attribution"]');
      if (!input) {
        input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'attribution';
        form.appendChild(input);
      }
      input.value = attribution;
    });
  }

  function track(name) {
    try {
      if (!navigator.sendBeacon) return;
      var body = new Blob([JSON.stringify({ e: name, p: location.pathname, r: document.referrer, a: attribution })], { type: 'application/json' });
      navigator.sendBeacon('/api/event', body);
    } catch (err) {}
  }
  window.bwjTrack = track;
  window.bwjInjectAttribution = injectAttribution;
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { injectAttribution(document); });
  else injectAttribution(document);
  document.addEventListener('click', function (ev) {
    var el = ev.target && ev.target.closest ? ev.target.closest('[data-track]') : null;
    if (el) track(el.getAttribute('data-track'));
  });
  document.addEventListener('focusin', function (ev) {
    var form = ev.target && ev.target.closest ? ev.target.closest('form[data-track-form]') : null;
    if (form && !form.dataset.trackStarted) {
      form.dataset.trackStarted = '1';
      track(form.getAttribute('data-track-form') + ':start');
    }
  });
  document.addEventListener('submit', function (ev) {
    var form = ev.target && ev.target.closest ? ev.target.closest('form[data-track-form]') : null;
    if (form) track(form.getAttribute('data-track-form') + ':submit');
  });
})();
</script>
    <script is:inline>
(function () {
  var siteKey = '0x4AAAAAAEJkiadExu7m9ULG';
  var protectedActions = ['/api/subscribe', '/api/contact', '/api/scorecard-report'];
  var scriptRequested = false;
  var scanQueued = false;

  function eligible(form) {
    if (!form || form.dataset.turnstileProtected) return false;
    try { return protectedActions.indexOf(new URL(form.action, location.href).pathname) !== -1; }
    catch (err) { return false; }
  }

  function setSubmitState(form, ready) {
    form.querySelectorAll('button[type="submit"], input[type="submit"]').forEach(function (button) {
      button.disabled = !ready;
    });
    var status = form.querySelector('.bwj-security-status');
    if (status) status.textContent = ready ? 'Security check complete.' : 'Completing security check…';
  }

  function protect(form) {
    if (!eligible(form) || !window.turnstile) return;
    form.dataset.turnstileProtected = '1';
    var container = document.createElement('div');
    container.className = 'bwj-turnstile';
    var status = document.createElement('span');
    status.className = 'bwj-security-status';
    status.textContent = 'Completing security check…';
    status.setAttribute('role', 'status');
    status.setAttribute('aria-live', 'polite');
    container.appendChild(status);
    var submit = form.querySelector('button[type="submit"], input[type="submit"]');
    if (submit) submit.insertAdjacentElement('beforebegin', container);
    else form.appendChild(container);
    setSubmitState(form, false);

    var widgetId = window.turnstile.render(container, {
      sitekey: siteKey,
      action: 'lead-form',
      appearance: 'interaction-only',
      size: 'flexible',
      callback: function () { setSubmitState(form, true); },
      'expired-callback': function () { setSubmitState(form, false); },
      'timeout-callback': function () { setSubmitState(form, false); },
      'error-callback': function () { setSubmitState(form, false); },
    });
    form.dataset.turnstileWidget = String(widgetId);
    form.addEventListener('submit', function (event) {
      if (!form.querySelector('input[name="cf-turnstile-response"]')?.value) {
        event.preventDefault();
        event.stopImmediatePropagation();
        setSubmitState(form, false);
      }
    }, true);
  }

  function scan() {
    scanQueued = false;
    if (!window.turnstile) return;
    document.querySelectorAll('form').forEach(protect);
  }

  function queueScan() {
    if (scanQueued) return;
    scanQueued = true;
    requestAnimationFrame(scan);
  }

  function load() {
    if (!document.querySelector('form') || scriptRequested) return;
    if (![...document.querySelectorAll('form')].some(eligible)) return;
    scriptRequested = true;
    var script = document.createElement('script');
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    script.async = true;
    script.defer = true;
    script.onload = scan;
    document.head.appendChild(script);
  }

  var observer = new MutationObserver(function () {
    if (!scriptRequested) load();
    else queueScan();
  });
  observer.observe(document.documentElement, { childList: true, subtree: true });
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', load);
  else load();
})();
</script>
    <style is:inline>
      .bwj-security-status { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
      .bwj-turnstile { margin-block: .5rem; max-width: 100%; }
    </style>
    {!bare && <a href="#main" class="skip-link">Skip to content</a>}
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {article && <EmailCapture />}
    {!bare && !hideFooter && <Footer />}
  </body>
</html>
