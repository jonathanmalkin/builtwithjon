---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EmailCapture from '../components/EmailCapture.astro';
import SEOHead from '../components/SEOHead.astro';
import JsonLd from '../components/JsonLd.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  schema?: Record<string, unknown>;
  noindex?: boolean;
  hideFooter?: boolean;
  bare?: boolean;
}

const {
  title,
  description,
  image,
  article,
  publishedTime,
  modifiedTime,
  schema,
  noindex,
  hideFooter = false,
  bare = false,
} = Astro.props;

const pageTitle = title === 'Jonathan Malkin'
  ? title
  : `${title} | Jonathan Malkin`;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Jonathan Malkin" href="/rss.xml" />
    <title>{pageTitle}</title>
    <SEOHead
      title={pageTitle}
      description={description}
      image={image}
      article={article}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      noindex={noindex}
    />
    {schema && <JsonLd schema={schema} />}
    <!-- Cloudflare Web Analytics is injected at the edge through Automatic Setup. -->
  </head>
  <body class={bare ? 'bare' : undefined}>
    <script is:inline>
(function () {
  var attribution = '';
  var storageKey = 'bwj_attribution';
  var maxAge = 30 * 24 * 60 * 60 * 1000;
  var fields = [
    ['utm_source', 's'], ['utm_medium', 'm'], ['utm_campaign', 'c'],
    ['utm_content', 'ct'], ['utm_term', 't'], ['src', 'src'],
    ['ref', 'ref'], ['gclid', 'g']
  ];

  function clean(value) {
    return String(value || '').replace(/[^A-Za-z0-9_\-|=.%+ ]/g, '').trim();
  }

  try {
    var stored = localStorage.getItem(storageKey) || '';
    var separator = stored.indexOf('|');
    var expiresAt = separator > 0 ? Number(stored.slice(0, separator)) : 0;
    if (expiresAt > Date.now()) attribution = clean(stored.slice(separator + 1)).slice(0, 240);
    else if (stored) localStorage.removeItem(storageKey);

    var params = new URLSearchParams(location.search);
    var parts = [];
    fields.forEach(function (field) {
      var value = clean(params.get(field[0]));
      if (value) parts.push(field[1] + '=' + value);
    });
    if (parts.length && !attribution) {
      attribution = parts.join('|').slice(0, 240);
      localStorage.setItem(storageKey, String(Date.now() + maxAge) + '|' + attribution);
    }
  } catch (err) {}

  function injectAttribution(root) {
    var scope = root && root.querySelectorAll ? root : document;
    scope.querySelectorAll('form[action^="/api/"]').forEach(function (form) {
      var input = form.querySelector('input[name="attribution"]');
      if (!input) {
        input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'attribution';
        form.appendChild(input);
      }
      input.value = attribution;
    });
  }

  function track(name) {
    try {
      if (!navigator.sendBeacon) return;
      var body = new Blob([JSON.stringify({ e: name, p: location.pathname, r: document.referrer, a: attribution })], { type: 'application/json' });
      navigator.sendBeacon('/api/event', body);
    } catch (err) {}
  }
  window.bwjTrack = track;
  window.bwjInjectAttribution = injectAttribution;
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { injectAttribution(document); });
  else injectAttribution(document);
  document.addEventListener('click', function (ev) {
    var el = ev.target && ev.target.closest ? ev.target.closest('[data-track]') : null;
    if (el) track(el.getAttribute('data-track'));
  });
  document.addEventListener('focusin', function (ev) {
    var form = ev.target && ev.target.closest ? ev.target.closest('form[data-track-form]') : null;
    if (form && !form.dataset.trackStarted) {
      form.dataset.trackStarted = '1';
      track(form.getAttribute('data-track-form') + ':start');
    }
  });
  document.addEventListener('submit', function (ev) {
    var form = ev.target && ev.target.closest ? ev.target.closest('form[data-track-form]') : null;
    if (form) track(form.getAttribute('data-track-form') + ':submit');
  });
})();
</script>
    {!bare && <a href="#main" class="skip-link">Skip to content</a>}
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {article && <EmailCapture />}
    {!bare && !hideFooter && <Footer />}
  </body>
</html>
