---
import Base from '../layouts/Base.astro';
const preview = import.meta.env.CONTACT_PREVIEW === 'true';
---
<Base title="Exchange details with Jonathan" description="Scan to share your details with Jonathan Malkin." noindex bare bodyClass="contact-exchange">
  <div class="exchange-page exchange-qr">
    {preview && <p class="exchange-preview">Preview: this QR points to builtwithjon.com. The updated page is not published yet.</p>}
    <h1>Scan to stay in touch.</h1>
    <a class="exchange-qr-link" href="/card/" aria-label="Open Jonathan’s contact exchange"><img class="exchange-qr-image" src="/contact/qr-website.png" width="1000" height="1000" alt="QR code for builtwithjon.com/card/" /></a>
    <p class="exchange-qr-owner">Jonathan Malkin · builtwithjon.com/card</p>
    <div class="exchange-downloads"><a href="/contact/qr-website.png" download="jonathan-contact-qr.png">Download image</a><a href="/contact/qr-website.svg" download="jonathan-contact-qr.svg">Print version</a></div>
  </div>
</Base>
