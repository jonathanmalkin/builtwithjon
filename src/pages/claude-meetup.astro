---
import Base from '../layouts/Base.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Claude Meetup | Build a Company Brain',
  description:
    'A practical starting point for giving Claude a clear route into prepared, source-linked company context.',
  url: 'https://builtwithjon.com/claude-meetup',
};
---

<Base
  title="Claude Meetup"
  description="Want a company brain that gives Claude a clear route into prepared, source-linked context? Start with one recurring question."
  schema={pageSchema}
>
  <section class="meetup-hero container-wide">
    <div class="meetup-copy">
      <p class="eyebrow">Austin Claude Meetup</p>
      <p class="meetup-kicker">Give Claude a map, not a dump.</p>
      <h1>Want one for your company?</h1>
      <p class="meetup-lede">
        Start with one recurring question that currently takes five places to
        answer. I build the prepared context, file routes, and workflows that
        help Claude find the right material and use it consistently.
      </p>
      <div class="meetup-actions">
        <a href="/contact/" class="hero-btn" data-track="cta:claude-meetup-contact">Talk with Jonathan</a>
        <a href="mailto:jonathan@builtwithjon.com?subject=Company%20brain%20after%20the%20Claude%20Meetup" class="meetup-email" data-track="cta:claude-meetup-email">jonathan@builtwithjon.com</a>
      </div>
    </div>

    <div class="meetup-route" aria-label="A three-step route from a company question to prepared context">
      <div class="meetup-route-step">
        <span>1</span>
        <strong>Choose the question</strong>
        <p>Start with one repeated decision, briefing, or lookup.</p>
      </div>
      <div class="meetup-route-step">
        <span>2</span>
        <strong>Prepare the context</strong>
        <p>Turn the relevant sources into usable, privacy-aware material.</p>
      </div>
      <div class="meetup-route-step">
        <span>3</span>
        <strong>Give Claude the route</strong>
        <p>Put the map and workflow beside the work they govern.</p>
      </div>
    </div>
  </section>

  <section class="meetup-start container">
    <p class="eyebrow">The useful first conversation</p>
    <h2>What question should your first route answer?</h2>
    <p>
      Bring the question, the systems your team checks today, and the people who
      need to trust the result. We can map the smallest useful version from there.
    </p>
    <a href="/contact/" class="hero-btn" data-track="cta:claude-meetup-start">Start the conversation</a>
  </section>

  <style>
    .meetup-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(340px, 0.8fr);
      gap: clamp(2.25rem, 6vw, 5.5rem);
      align-items: center;
      padding-top: clamp(2.5rem, 6vw, 5.5rem);
      padding-bottom: clamp(3rem, 7vw, 6.5rem);
    }

    .meetup-kicker {
      color: var(--color-blue-mug);
      font-family: var(--font-serif);
      font-size: clamp(1.2rem, 2.4vw, 1.65rem);
      font-weight: 600;
      margin: 0.8rem 0 0;
    }

    .meetup-copy h1 {
      max-width: 760px;
      margin: 0.35rem 0 1.15rem;
      font-size: clamp(3rem, 7.6vw, 6.4rem);
      line-height: 0.91;
      letter-spacing: -0.055em;
    }

    .meetup-lede {
      max-width: 670px;
      margin: 0;
      color: var(--color-text-muted);
      font-size: clamp(1.05rem, 2vw, 1.25rem);
      line-height: 1.55;
    }

    .meetup-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.9rem 1.1rem;
      margin-top: 1.7rem;
    }

    .meetup-email {
      font-size: 0.92rem;
      font-weight: 650;
    }

    .meetup-route {
      position: relative;
      display: grid;
      gap: 0.9rem;
      padding: clamp(1rem, 2vw, 1.35rem);
      border: 1px solid var(--color-border);
      border-radius: 18px;
      background:
        radial-gradient(circle at 12% 10%, rgba(59, 110, 143, 0.13), transparent 35%),
        var(--color-surface);
      box-shadow: var(--shadow-card);
    }

    .meetup-route-step {
      display: grid;
      grid-template-columns: 2.4rem 1fr;
      gap: 0.2rem 0.85rem;
      align-items: center;
      padding: 1rem;
      border: 1px solid var(--color-border);
      border-radius: 10px;
      background: var(--color-paper);
    }

    .meetup-route-step span {
      grid-row: 1 / 3;
      display: grid;
      place-items: center;
      width: 2.4rem;
      height: 2.4rem;
      border-radius: 50%;
      background: var(--color-blue-mug);
      color: #fff;
      font-family: var(--font-mono);
      font-weight: 700;
    }

    .meetup-route-step strong {
      font-family: var(--font-body);
      font-size: 1rem;
    }

    .meetup-route-step p {
      margin: 0;
      color: var(--color-text-muted);
      font-size: 0.88rem;
      line-height: 1.45;
    }

    .meetup-start {
      margin-bottom: clamp(3rem, 7vw, 6rem);
      padding: clamp(1.5rem, 4vw, 2.5rem);
      border-top: 1px solid var(--color-border);
      text-align: center;
    }

    .meetup-start h2 {
      max-width: 780px;
      margin: 0.45rem auto 0.8rem;
      font-size: clamp(2rem, 4.5vw, 3.5rem);
      line-height: 1.02;
      letter-spacing: -0.04em;
    }

    .meetup-start > p:not(.eyebrow) {
      max-width: 660px;
      margin: 0 auto 1.35rem;
      color: var(--color-text-muted);
      line-height: 1.55;
    }

    @media (max-width: 780px) {
      .meetup-hero {
        grid-template-columns: 1fr;
      }

      .meetup-copy h1 {
        font-size: clamp(3rem, 15vw, 5rem);
      }
    }
  </style>
</Base>
