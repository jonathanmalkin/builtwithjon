import Base from '../layouts/Base.astro';
import ScanCard from '../components/ScanCard.astro';
import { MEETUP_ORIGIN } from '../data/scan-origins';
---

<Base
  title="Jonathan Malkin"
  description="Share your details with Jonathan Malkin, then start a text conversation."
  noindex
  bare
  bodyClass="contact-exchange"
>
  <ScanCard {...MEETUP_ORIGIN} />
</Base>
