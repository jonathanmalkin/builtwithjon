---
// Contact, October 2026 revamp. One heading, one line and the same message
// form as every other page (October 6 review round).
// Site map: Workspace/04-Marketing/Website/2026-10-05-workshops-led-update.md
// Pages approved as built by Jonathan on October 6, 2026. Nothing deploys without his word.
import Odl from '../layouts/Odl.astro';
import MessageForm from '../components/MessageForm.astro';
import { buildPersonSchema } from '../lib/schema.js';
import { BIO } from '../data/odl';

const description = 'Get in touch with Jonathan Malkin about a workshop, a session for your members, a talk, or anything else. He replies by email.';
const personSchema = buildPersonSchema({ description: BIO.medium });
---

<Odl title="Contact" description={description} schema={personSchema}>
  <div class="band-parch">
    <MessageForm kind="contact" id="message" level={1} heading="Get in touch." intro="About a workshop, a session for your members, a talk, or anything else. A sentence is enough." button="Send" track="contact" />
  </div>
</Odl>
