---
// Speaking, October 2026 revamp. For event organizers and podcast hosts.
// Site map: Workspace/04-Marketing/Website/2026-10-05-workshops-led-update.md
// Copy is draft until Jonathan approves it page by page.
import Odl from '../layouts/Odl.astro';
import { buildPersonSchema } from '../lib/schema.js';
import MessageForm from '../components/MessageForm.astro';
import { SITE, TALKS, BIO, MATERIALS } from '../data/odl';

const description = 'For event organizers and podcast hosts: talks and demos by Jonathan Malkin on making AI useful in a business, with topics, formats, the decks and a headshot.';
const personSchema = buildPersonSchema({
  description: BIO.medium,
  url: `${SITE.url}/speaking/`,
  knowsAbout: ['AI for business owners and executives', 'applied AI in small business', 'organizing business knowledge for AI', 'personal AI assistants'],
});

const topics = [
  {
    title: 'Tried AI. Didn’t stick.',
    text: 'Why AI stalls in a business after the first few weeks, and the three habits that get it into the daily work.',
    leave: 'One change to make on Monday.',
    who: 'For owners and executives.',
  },
  {
    title: 'One task, not a transformation.',
    text: 'How to choose one recurring task, define what a useful result looks like, and decide whether AI earns its place.',
    leave: 'A task chosen and a yardstick for it.',
    who: 'Works as a talk or a hands-on session.',
  },
  {
    title: 'Give Claude a map, not a dump.',
    text: 'Why general tools give general answers, and how to organize what your business knows so people and AI can both use it.',
    leave: 'A folder map sketched for your own business.',
  },
  {
    title: 'An assistant that knows your week.',
    text: 'A live walk through preparing for meetings, turning notes into next steps, and a daily brief.',
    leave: 'The setup steps to repeat at your desk.',
  },
  {
    title: 'Two Agents, One Brain.',
    text: 'A live demo of two AI agents working from one shared structure of plain files and folders, and what that structure needs to look like.',
    leave: 'A structure to copy.',
    who: 'For technical audiences. Fifteen minutes.',
  },
];

const details = [
  { name: 'Talk with questions', detail: '20 to 60 minutes.' },
  { name: 'Hands-on workshop', detail: '90 minutes. Everyone works on a task from their own week.' },
  { name: 'Podcast or panel', detail: 'Your format and your length.' },
  { name: 'Live demo for a technical audience', detail: '15 minutes.' },
  { name: 'Remote or in person', detail: 'Both. Online sessions run on your platform or mine, with the same hands-on format.' },
  { name: 'Based in', detail: `${SITE.city}. I travel for the right room.` },
  { name: 'Technical needs', detail: 'A screen with HDMI or wireless display, and wifi. I bring my laptop and adapters, and a lapel mic for rooms over about forty.' },
];

const bios = [
  { id: 'bio-short', label: 'Short', note: 'One sentence, for a program or a listing.', text: BIO.short },
  { id: 'bio-medium', label: 'Medium', note: 'A paragraph, for an event page or show notes.', text: BIO.medium },
  { id: 'bio-intro', label: 'Introduction', note: 'To read aloud before the talk.', text: BIO.intro },
];
---

<Odl title="Speaking: Jonathan Malkin, AI Educator in Austin" description={description} image="/home/austin-keynote.jpg" imageWidth={1600} imageHeight={1066} schema={personSchema}>

  <section class="sec band-parch" aria-labelledby="hero-h">
    <div class="inner split media-left" style="padding:0">
      <div>
        <h1 id="hero-h">Talks and demos on making AI useful in a business.</h1>
        <p class="lede">I speak and teach on one subject: making AI useful in a real business. Audiences are owners, executives and their teams, and the people who build for them. I keep it practical and I show the work.</p>
        <div class="actions">
          <a class="btn" href="#message" data-track="cta:speaking-hero">Invite me to speak <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <figure class="photo" style="aspect-ratio:3/2">
        <img src="/home/austin-keynote.jpg" width="1600" height="1066" fetchpriority="high" alt="Jonathan Malkin presenting beside a laptop, with his name on the screen behind him." />
      </figure>
    </div>
  </section>

  <section class="sec" aria-labelledby="topics-h">
    <div class="inner">
      <div class="sec-head">
        <h2 id="topics-h">What I talk about</h2>
        <p>Five topics, each shaped to the room. Every one includes something the audience can try the same week.</p>
      </div>
      <ul class="rows">
        {topics.map((t) => (
          <li>
            <div>
              <h3>{t.title}</h3>
              {t.who && <span class="meta">{t.who}</span>}
            </div>
            <div>
              <p>{t.text}</p>
              <span class="leave">The audience leaves with: {t.leave}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec" id="talks" aria-labelledby="talks-h">
    <div class="inner">
      <div class="sec-head">
        <h2 id="talks-h">Talks and decks</h2>
        <p>Recent and upcoming. The slides go up here after each talk, free to read, no email required.</p>
      </div>
      <ul class="rows">
        {TALKS.map((t) => (
          <li>
            <div>
              <h3>{t.title}</h3>
              <span class="meta">{t.event}<br />{t.where}<br />{t.date}</span>
            </div>
            <div>
              <p>{t.desc}</p>
              {t.href && <a class="go" href={t.href}>{t.linkLabel} <span class="arrow" aria-hidden="true">→</span></a>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec band-parch" id="decks" aria-labelledby="decks-h">
    <div class="inner">
      <div class="sec-head">
        <h2 id="decks-h">The decks</h2>
        <p>As they were shown. A workshop is where you build your own version, with help beside you.</p>
      </div>
      <ul class="tiles two">
        {MATERIALS.map((m) => (
          <li>
            <a class="tile" href={m.href}>
              <span class="tile-shot"><img src={m.cover.src} alt={m.cover.alt} loading="lazy" width="800" height="500" /></span>
              <span class="tile-body"><strong>{m.title}</strong><p>{m.desc}</p><span class="chip">{m.tag}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec band-clay" aria-labelledby="org-h">
    <div class="inner duo" style="align-items:start">
      <div>
        <h2 id="org-h">For organizers</h2>
        <p>Tell me the slot you have and who will be in the room. I will suggest the format that fits.</p>
        <figure class="photo headshot">
          <img src="/images/jonathan-malkin.jpg" width="800" height="800" loading="lazy" alt="Jonathan Malkin, headshot." />
          <figcaption><a href="/images/jonathan-malkin.jpg">Download the headshot</a>, or the <a href="/home/austin-portrait.jpg">stage photo</a>. {SITE.person}; Malkin is said MAL-kin.</figcaption>
        </figure>
      </div>
      <ul class="facts">
        {details.map((f) => (
          <li><strong>{f.name}</strong><span>{f.detail}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <MessageForm kind="contact" id="message" heading="Invite me to speak" intro="The date, the audience and the format you have in mind. I will come back with what fits." button="Send the invitation" track="contact" />
</Odl>

<style>
  .facts a,.aside-band p a,.sec-head p a,.headshot a{color:var(--ink);font-weight:600;text-decoration:underline}
  .headshot{margin-top:28px;max-width:260px}
  .headshot img{display:block;width:100%;height:auto;border-radius:14px}
  .headshot figcaption{margin-top:10px;font-size:.95rem;color:var(--cap)}
</style>


