---
// Host a workshop, October 2026 revamp. For hosts: chambers, associations,
// peer groups, co-working communities and companies training a team.
// Four sections since October 6, 14:50: hero, what your group gets, the
// three kinds of rooms, the form. The questions moved to /faq/; how it works
// and rooms like yours were cut. No prices here.
// Site map: Workspace/04-Marketing/Website/2026-10-05-workshops-led-update.md
// Copy is draft until Jonathan approves it page by page.
import Odl from '../layouts/Odl.astro';
import MessageForm from '../components/MessageForm.astro';
import { WORKSHOPS, FORMATS } from '../data/odl';

const description = 'Bring a hands-on AI workshop to your chamber, association, peer group, portfolio or team. Plain language, no sales pitch, a useful result for each person.';

const gets = [
  { title: 'A session set to where the room actually is.', text: 'From people opening an AI tool for the first time to people who use one every day. I ask about the group beforehand and pitch the session to match.' },
  { title: 'Hands-on time on their own work.', text: 'Each person works on their own tasks, on their own laptop, with the AI tool they already use.' },
  { title: 'One practical result per person.', text: 'A working tool or workflow, a skill applied to their own work, or a clear decision about where to start.' },
];

const byFormat = FORMATS.map((f) => ({ ...f, names: WORKSHOPS.filter((w) => w.format === f.id).map((w) => w.name) }));
---

<Odl title="AI Workshops for the Group You Gather" description={description}>
  <section class="hero host-hero" aria-labelledby="hero-h">
    <img src="/home/austin-hero.jpg" width="1082" height="1360" alt="Jonathan Malkin speaking to a room, holding a presentation clicker, with a name badge and a headset microphone." fetchpriority="high" />
    <div class="hero-card">
      <h1 id="hero-h">A practical AI session for the people you serve.</h1>
      <p class="lede">You gather owners, executives or a team: a chamber, an association, a peer group, a portfolio of companies. They are asking about AI. You want a session that is useful to them and reflects well on you. I teach hands-on workshops where each person works on their own business and leaves with something they can use.</p>
      <div class="actions">
        <a class="btn" href="#message" data-track="cta:host-hero">Tell me about your group <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="gets-h">
    <div class="inner duo" style="align-items:start">
      <div>
        <h2 id="gets-h">What your group gets</h2>
        <ul class="gets">
          {gets.map((g) => (
            <li>
              <h3>{g.title}</h3>
              <p>{g.text}</p>
            </li>
          ))}
        </ul>
      </div>
      <figure class="photo" style="aspect-ratio:4/3">
        <img src="/home/austin-keynote.jpg" width="1600" height="1066" loading="lazy" alt="Jonathan Malkin presenting beside a laptop, with his name on the screen behind him." />
      </figure>
    </div>
  </section>

  <section class="sec band-parch" aria-labelledby="sessions-h">
    <div class="inner">
      <div class="sec-head">
        <h2 id="sessions-h">Three kinds of rooms</h2>
        <p>I suggest one once I know who is coming. Group size, what you need to provide and who pays are in the <a href="/faq/">common questions</a>.</p>
      </div>
      <ul class="rows">
        {byFormat.map((f) => (
          <li>
            <div>
              <h3>{f.name}</h3>
              <span class="meta">{f.who}</span>
            </div>
            <div>
              <p>{f.how}</p>
              <p class="cap" style="margin-top:10px">{f.names.join('. ')}.</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <MessageForm kind="host" id="message" heading="Tell me about your group" intro="Who is in it, roughly how many, and when you are thinking of. If you want to know who you would be putting in front of your members first, there is more about me on the About page." button="Send" />
</Odl>

<style>
  @media(min-width:861px){
    .host-hero{background:var(--ink)}
    .host-hero>img{left:auto;right:0;width:58%;object-position:50% 15%;-webkit-mask-image:linear-gradient(to right,transparent,#000 22%);mask-image:linear-gradient(to right,transparent,#000 22%)}
  }
  @media(max-width:860px){
    .host-hero>img{object-position:50% 20%}
  }
  .gets{list-style:none;margin-top:28px;border-top:1.5px solid var(--ink)}
  .gets>li{padding:20px 0 22px;border-bottom:1px solid var(--line)}
  .gets h3{margin-bottom:8px;max-width:28ch}
  .sec-head p a{color:var(--ink);font-weight:600;text-decoration:underline}
</style>
