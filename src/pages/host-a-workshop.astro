---
// Host a workshop, October 2026 revamp. For hosts: chambers, associations,
// peer groups, co-working communities and companies training a team.
// Rebuilt October 6 after the review panel: shorter, the three kinds of
// room instead of the full catalogue, rooms by type, the no-pitch default
// stated plainly. No prices here.
// Site map: Workspace/04-Marketing/Website/2026-10-05-workshops-led-update.md
// Copy is draft until Jonathan approves it page by page.
import Odl from '../layouts/Odl.astro';
import MessageForm from '../components/MessageForm.astro';
import { buildFaqPageSchema } from '../lib/schema.js';
import { WORKSHOPS, FORMATS, ROOMS } from '../data/odl';

const description = 'Bring a hands-on AI workshop to your chamber, association, peer group, portfolio or team. Plain language, no sales pitch, a useful result for each person.';

const gets = [
  { title: 'A session set to where the room actually is.', text: 'From people opening an AI tool for the first time to people who use one every day. I ask about the group beforehand and pitch the session to match.' },
  { title: 'Hands-on time on their own work.', text: 'Each person works on their own tasks, on their own laptop, with the AI tool they already use.' },
  { title: 'One practical result per person.', text: 'A working tool or workflow, a skill applied to their own work, or a clear decision about where to start.' },
  { title: 'Plain language and no product pitch.', text: 'I collect no attendee contact details and make no offer from the front of the room. People who want more write to me themselves.' },
];

const how = [
  { title: 'You send a message.', text: 'Tell me about your group: who they are and what they are asking about AI.' },
  { title: 'We talk for 15 to 30 minutes.', text: 'About the audience and what would be useful to them.' },
  { title: 'I propose it in writing.', text: 'A session, a format and terms, written down so you can share them with whoever needs to agree.' },
  { title: 'You bring the room. I bring the session.', text: 'You gather people and promote it. I bring the session and the materials.' },
  { title: 'Afterward, a short summary.', text: 'What people worked on and what they asked about, sent to you after the session.' },
];

const questions = [
  { question: 'What does it cost?', answer: 'It depends on the format and the group. Hosts pay directly, bring a sponsor, or charge participants. I ask a few questions and propose terms in writing.' },
  { question: 'How many people?', answer: 'Hands-on works best from about ten to thirty. A larger room gets a talk with one exercise everyone does at their seat.' },
  { question: 'Will you sell to our members?', answer: 'No. The session is education. I collect no attendee contact details and make no offer from the front of the room. People who want more write to me themselves.' },
  { question: 'What do we need to provide?', answer: 'A room with a screen and reliable wifi, a rough count of who is coming, and for hands-on sessions a laptop per person with an account for the AI tool they use. A free account set up that morning is enough.' },
  { question: 'Can you tailor it to our industry?', answer: 'Yes, when I can learn enough about the work beforehand. I use examples from the participants’ own tasks.' },
  { question: 'In person or remote?', answer: 'In person in the Austin area, and online for groups elsewhere.' },
];
const faqSchema = buildFaqPageSchema(questions);
const byFormat = FORMATS.map((f) => ({ ...f, names: WORKSHOPS.filter((w) => w.format === f.id).map((w) => w.name) }));
---

<Odl title="AI Workshops for the Group You Gather" description={description} schema={faqSchema}>
  <section class="hero host-hero" aria-labelledby="hero-h">
    <img src="/home/austin-hero.jpg" width="1082" height="1360" alt="Jonathan Malkin speaking to a room, holding a presentation clicker, with a name badge and a headset microphone." fetchpriority="high" />
    <div class="hero-card">
      <h1 id="hero-h">A practical AI session for the people you serve.</h1>
      <p class="lede">You gather owners, executives or a team: a chamber, an association, a peer group, a portfolio of companies. They are asking about AI. You want a session that is useful to them and reflects well on you. I teach hands-on workshops where each person works on their own business and leaves with something they can use.</p>
      <div class="actions">
        <a class="btn" href="#message" data-track="cta:host-hero">Tell me about your group <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="gets-h">
    <div class="inner duo" style="align-items:start">
      <div>
        <h2 id="gets-h">What your group gets</h2>
        <ul class="gets">
          {gets.map((g) => (
            <li>
              <h3>{g.title}</h3>
              <p>{g.text}</p>
            </li>
          ))}
        </ul>
      </div>
      <figure class="photo" style="aspect-ratio:4/5">
        <img src="/home/austin-keynote.jpg" width="1600" height="1066" loading="lazy" alt="Jonathan Malkin presenting beside a laptop, with his name on the screen behind him." />
      </figure>
    </div>
  </section>

  <section class="sec band-parch" aria-labelledby="sessions-h">
    <div class="inner">
      <div class="sec-head">
        <h2 id="sessions-h">Three kinds of rooms</h2>
        <p>I suggest one once I know who is coming. <a href="/workshops/">The full list of workshops</a> says what each person leaves with.</p>
      </div>
      <ul class="rows">
        {byFormat.map((f) => (
          <li>
            <div>
              <h3>{f.name}</h3>
              <span class="meta">{f.who}</span>
            </div>
            <div>
              <p>{f.how}</p>
              <p class="cap" style="margin-top:10px">{f.names.join('. ')}.</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec" id="how" tabindex="-1" aria-labelledby="how-h">
    <div class="inner">
      <div class="sec-head">
        <h2 id="how-h">How it works</h2>
      </div>
      <ol class="steps five">
        {how.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec band-clay" aria-labelledby="rooms-h">
    <div class="inner">
      <div class="sec-head">
        <h2 id="rooms-h">Rooms like yours</h2>
        <p>Recent and booked sessions, described by type. Ask me about any of them.</p>
      </div>
      <ul class="rows">
        {ROOMS.map((r) => (
          <li>
            <div>
              <h3>{r.name}</h3>
              <span class="meta">{r.when}</span>
            </div>
            <p>{r.short}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec" aria-labelledby="qa-h">
    <div class="inner">
      <div class="sec-head">
        <h2 id="qa-h">Common questions</h2>
      </div>
      <ul class="qa">
        {questions.map((q) => (
          <li>
            <h3>{q.question}</h3>
            <p>{q.answer}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="band-parch">
    <MessageForm kind="host" id="message" heading="Tell me about your group" intro="Who is in it, roughly how many, and when you are thinking of. If you want to know who you would be putting in front of your members first, there is more about me on the About page." button="Send" />
  </div>
</Odl>

<style>
  @media(min-width:861px){
    .host-hero{background:var(--ink)}
    .host-hero>img{left:auto;right:0;width:58%;object-position:50% 15%;-webkit-mask-image:linear-gradient(to right,transparent,#000 22%);mask-image:linear-gradient(to right,transparent,#000 22%)}
  }
  @media(max-width:860px){
    .host-hero>img{object-position:50% 20%}
  }
  .gets{list-style:none;margin-top:28px;border-top:1.5px solid var(--ink)}
  .gets>li{padding:20px 0 22px;border-bottom:1px solid var(--line)}
  .gets h3{margin-bottom:8px;max-width:28ch}
  .sec-head p a{color:var(--ink);font-weight:600;text-decoration:underline}
  @media(min-width:1100px){
    .steps.five{grid-template-columns:repeat(5,minmax(0,1fr));gap:0 32px}
    .steps.five h3{font-size:1.25rem}
  }
</style>
