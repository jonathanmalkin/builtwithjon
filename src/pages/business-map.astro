---
import Base from '../layouts/Base.astro';
import JsonLd from '../components/JsonLd.astro';
import { buildPersonSchema, buildProfessionalServiceSchema } from '../lib/schema.js';

// The forwardable offer page a referrer sends someone to, and the site's one
// conversion surface. Same letter grammar as the homepage, denser.
// Copy: finalized from Workspace/04-Marketing/Website/business-map-page-copy-DRAFT-2026-08-15.md
// via voice-editor. Intake spec: Jonathan, 2026-08-15 review. Email is captured
// first (step 1) so a partial completion still yields the lead; the
// qualification questions follow (step 2). The authority question is removed
// from the public form on purpose.
//
// NOTE: lead capture will not fully succeed until the real Sender group id
// replaces the "offer:business-map" placeholder for SENDER_GROUP_IDS in
// wrangler.jsonc (Jonathan's task; see FORM_MAP in src/worker.js).

const description =
  'The Business Map is the first phase of a build. Your people, process, and systems on one page, then a clear decision about what to build first.';

const personSchema = buildPersonSchema({
  description: 'Jonathan Malkin helps owner-led businesses turn knowledge trapped in people and scattered tools into systems their team and AI can actually use.',
});

const professionalServiceSchema = buildProfessionalServiceSchema({
  description: 'Business knowledge mapping and company brain builds for owner-led businesses in Austin and across the United States.',
  founder: personSchema,
  makesOffer: [
    {
      '@type': 'Offer',
      name: 'The Business Map',
      description: 'The first phase of a build: your people, process, and systems mapped onto one page, then a clear decision about what to build first.',
      url: 'https://builtwithjon.com/business-map/',
    },
  ],
});
---

<Base
  title="The Business Map for Owner-Led Businesses | Austin, TX"
  description={description}
  schema={personSchema}
>
  <JsonLd schema={professionalServiceSchema} />

  <div class="letter">
    <header class="letter-open">
      <p class="letter-dateline">First phase of a build</p>
      <h1>The Business Map</h1>
      <p class="letter-lede">
        Someone told you to talk to me. This is what they were pointing at, and what happens after we talk.
      </p>
      <div class="letter-cta">
        <a href="#start" class="hero-btn">Start with the Business Map</a>
      </div>
    </header>

    <section aria-labelledby="what-h">
      <h2 id="what-h">What is the Business Map?</h2>
      <p>
        The Business Map is the first phase of a build. I put your people, process, and systems on one page, and we end with a clear decision about what to build first.
      </p>
      <p>
        It is not a report you file and forget. It is the start of the work, and it ends in a straightforward call: continue into the build, or stop here with the map you paid for. Either way you keep the map.
      </p>
      <p>
        What the Map gives you is a way to see your business as systems on a page, and enough clarity to make that build-or-stop call with confidence. It is the thing that gets the project you have been putting off finally moving.
      </p>
    </section>

    <hr class="letter-rule" />

    <section aria-labelledby="fit-h">
      <h2 id="fit-h">Who is it a fit for?</h2>
      <p>The Business Map is a fit if:</p>
      <ol class="fit-list">
        <li>There's a project you keep putting off because getting the information together is too painful.</li>
        <li>Someone besides you needs answers the business can't give them today.</li>
        <li>Nobody on your team is already building this and expecting to finish it.</li>
        <li>You can make the call to move forward, or you know whose call it is.</li>
      </ol>
      <p>If that sounds like your business, the intake below is the place to start.</p>
    </section>

    <hr class="letter-rule" />

    <section aria-labelledby="get-h">
      <h2 id="get-h">What do you get?</h2>
      <ul>
        <li>Your knowledge, data, workflow, and friction mapped against the project you actually want to move.</li>
        <li>The one place the first build should start, and why.</li>
        <li>A clear continue-or-stop decision, with a build scoped only if it makes sense.</li>
      </ul>
    </section>

    <hr class="letter-rule" />

    <section id="start" aria-labelledby="start-h">
      <h2 id="start-h">How do you start?</h2>
      <p>
        Start with the Business Map. The short intake below is how we both see if it's a fit, and how I make sure the first build is worth both our time. I read every intake myself and reply.
      </p>
      <p>
        I take one build at a time. The next Business Map can start as the current build wraps, so the intake is also how you hold your place.
      </p>
      <p>
        No book-a-call button here on purpose. Most weeks I'm inside a build, and the intake keeps the next one focused.
      </p>

      <form
        action="/api/subscribe"
        method="POST"
        class="intake bm-step1"
        data-track-form="business-map"
      >
        <p class="intake-progress">Step 1 of 2 &middot; Your email holds your place</p>
        <input type="hidden" name="_subject" value="Business Map intake (step 1)" />
        <input type="hidden" name="inquiry_type" value="business-map-intake" />
        <input type="hidden" name="form_id" value="business-map" />
        <input type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" class="form-honeypot" />

        <div class="form-group">
          <label for="bm-email">Email</label>
          <input type="email" id="bm-email" name="email" required class="form-input" autocomplete="email" inputmode="email" spellcheck="false" />
          <p class="intake-hint">Two more questions follow. If you stop after this step, I still know you're interested.</p>
        </div>

        <div class="form-group">
          <label for="bm-name">Name <span class="form-optional">(optional)</span></label>
          <input type="text" id="bm-name" name="name" class="form-input" autocomplete="name" />
        </div>

        <button type="submit" class="form-submit">Start with the Business Map</button>
        <p class="intake-status" hidden role="status"></p>
      </form>

      <template id="bm-step2-template">
        <form
          action="/api/subscribe"
          method="POST"
          class="intake bm-step2"
          data-track-form="business-map-details"
        >
          <p class="intake-done" role="status">Got your email. One short step left.</p>
          <p class="intake-progress">Step 2 of 2 &middot; Three questions</p>
          <input type="hidden" name="_subject" value="Business Map intake (step 2)" />
          <input type="hidden" name="inquiry_type" value="business-map-intake" />
          <input type="hidden" name="form_id" value="business-map-details" />
          <input type="hidden" name="email" value="" />
          <input type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" class="form-honeypot" />

          <div class="form-group">
            <label for="bm-blocked-project">What's the project you keep putting off?</label>
            <textarea id="bm-blocked-project" name="blocked_project" rows="3" required maxlength="2000" class="form-input"></textarea>
          </div>

          <fieldset class="form-group">
            <legend>Do one or two people have all the info trapped in their heads?</legend>
            <div class="yesno">
              <label><input type="radio" name="key_person" value="Yes" required /> Yes</label>
              <label><input type="radio" name="key_person" value="No" /> No</label>
            </div>
          </fieldset>

          <fieldset class="form-group">
            <legend>Is anyone on your team already building something like this?</legend>
            <div class="yesno">
              <label><input type="radio" name="already_building" value="Yes" required /> Yes</label>
              <label><input type="radio" name="already_building" value="No" /> No</label>
            </div>
          </fieldset>

          <button type="submit" class="form-submit">Send the intake</button>
          <p class="intake-status" hidden role="status"></p>
        </form>
      </template>
      <div class="bm-step2-slot"></div>
    </section>

    <hr class="letter-rule" />

    <section aria-labelledby="trust-h">
      <h2 id="trust-h">What can you count on?</h2>
      <div class="fine-note">
        <p>
          You own the platform, the credentials, the data, and the final system. High-stakes decisions stay with people. Sensitive material gets privacy treatment with a required human review step, which is treatment, not a guarantee of complete de-identification.
        </p>
      </div>
    </section>
  </div>
</Base>

<script>
  const step1 = document.querySelector('.bm-step1');
  const step2Template = document.getElementById('bm-step2-template');
  const step2Slot = document.querySelector('.bm-step2-slot');

  function statusEl(form) {
    return form.querySelector('.intake-status');
  }

  function showStatus(form, message) {
    const status = statusEl(form);
    if (status) {
      status.textContent = message;
      status.hidden = false;
    }
  }

  async function submitIntake(form) {
    const response = await fetch(form.action, {
      method: 'POST',
      body: new FormData(form),
      headers: { Accept: 'application/json' },
    });
    const result = await response.json().catch(() => ({}));
    if (!response.ok || !result.ok) throw new Error(result.error || 'intake_failed');
    return result;
  }

  function wireStep2(email) {
    if (!step2Template || !step2Slot || step2Slot.querySelector('form')) return;
    step2Slot.appendChild(step2Template.content.cloneNode(true));
    const step2 = step2Slot.querySelector('.bm-step2');
    if (!step2) return;
    const emailField = step2.querySelector('input[name="email"]');
    if (emailField) emailField.value = email;
    if (window.bwjInjectAttribution) window.bwjInjectAttribution(step2Slot);

    step2.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!step2.checkValidity()) {
        step2.reportValidity();
        return;
      }
      const button = step2.querySelector('button[type="submit"]');
      if (button) {
        button.disabled = true;
        button.textContent = 'Sending...';
      }
      try {
        await submitIntake(step2);
        if (window.bwjTrack) window.bwjTrack('business-map:success');
        step2.querySelectorAll('.form-group, button[type="submit"], .intake-progress, .intake-done').forEach((el) => {
          el.hidden = true;
        });
        showStatus(step2, 'Got it. I read every intake myself and will reply.');
      } catch (err) {
        showStatus(step2, 'That did not go through. Email jonathan@builtwithjon.com and I will follow up.');
        if (button) {
          button.disabled = false;
          button.textContent = 'Send the intake';
        }
      }
    });

    step2.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    const firstField = step2.querySelector('textarea');
    if (firstField) firstField.focus({ preventScroll: true });
  }

  step1?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!step1.checkValidity()) {
      step1.reportValidity();
      return;
    }
    const button = step1.querySelector('button[type="submit"]');
    if (button) {
      button.disabled = true;
      button.textContent = 'Saving...';
    }
    try {
      await submitIntake(step1);
      if (window.bwjTrack) window.bwjTrack('business-map:capture');
      const email = step1.querySelector('input[name="email"]')?.value || '';
      step1.hidden = true;
      wireStep2(email);
    } catch (err) {
      showStatus(step1, 'That did not go through. Email jonathan@builtwithjon.com and I will follow up.');
      if (button) {
        button.disabled = false;
        button.textContent = 'Start with the Business Map';
      }
    }
  });
</script>
