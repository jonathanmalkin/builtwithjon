---
import Base from '../layouts/Base.astro';

const description =
  "I help owner-led businesses turn knowledge trapped in people and scattered tools into systems their team and AI can actually use.";
---

<Base title="Workshops" description={description}>
  <section class="container-wide section-band">
    <p class="eyebrow">Workshops</p>
    <h1>Workshops</h1>
    <p class="subtitle">{description}</p>
    <div class="hero-links">
      <a href="/contact/" class="hero-btn">Ask about a workshop</a>
    </div>
    <!-- TODO: swap in approved copy from Workspace/04-Marketing/Website/*-DRAFT-2026-08-15.md
         (a fuller draft to model from is preserved at src/_drafts/workshops-index.astro) -->
  </section>
</Base>
