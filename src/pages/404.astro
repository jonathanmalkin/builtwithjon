---
import Odl from '../layouts/Odl.astro';
---

<Odl title="Page not found" description="That page does not exist. Maybe it moved, maybe it never did." noindex={true}>
  <section class="sec band-parch">
    <div class="inner narrow">
      <h1>That page is not here.</h1>
      <p class="lede" style="margin-top:16px">Maybe it moved, maybe it never existed. The site was reorganized in October 2026 around the workshops.</p>
      <div class="actions" style="margin-top:28px">
        <a class="btn" href="/">Home <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Odl>
