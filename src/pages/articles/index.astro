---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import multipleEmailHero from '../../assets/articles/multiple-email-accounts-with-claude/option-c-whiteboard-v3.png';
import decisionModelsCover from '../../assets/articles/113-decision-models-in-3-weeks/cover.jpg';

const cardImages: Record<string, { image: ImageMetadata; alt: string }> = {
  'multiple-email-accounts-with-claude': {
    image: multipleEmailHero,
    alt: 'Hand-drawn whiteboard sketch showing three numbered groups of options for connecting multiple email accounts to Claude.',
  },
  '113-decision-models-in-3-weeks': {
    image: decisionModelsCover,
    alt: 'Hand-drawn whiteboard sketch of a fox feeding papers into a decision machine that sorts cards into yes, no and unsure trays with confidence percentages.',
  },
};

const contentArticles = (await getCollection('articles', ({ data }) => !data.draft))
  .map((article) => ({
    title: article.data.title,
    slug: article.id,
    date: article.data.date,
    description: article.data.description,
    story: article.data.story,
    image: cardImages[article.id]?.image,
    imageAlt: cardImages[article.id]?.alt,
  }));

const articles = contentArticles
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());
---

<Base
  title="Articles"
  description="Articles on Claude Code, AI operations, implementation strategy, and building practical automation systems."
>
  <div class="container">
    <h1>Articles</h1>
    <p style="color: var(--color-text-muted); margin-bottom: 2rem;">
      Long-form writing about AI infrastructure, implementation strategy, and how to make automation useful in day-to-day operations.
    </p>
    {articles.map((article) => (
      <ArticleCard
        title={article.title}
        slug={article.slug}
        date={article.date}
        description={article.description}
        story={article.story}
        image={article.image}
        imageAlt={article.imageAlt}
      />
    ))}
  </div>
</Base>
