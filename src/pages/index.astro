---
import Base from '../layouts/Base.astro';
import JsonLd from '../components/JsonLd.astro';
import { buildPersonSchema, buildProfessionalServiceSchema } from '../lib/schema.js';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/schibsted-grotesk';

// DIRECTION CONTRACT (2026-08-17 design-lab session, composite v12 + H-C1 hero)
// THESIS: One argument told as full-bleed bands: a mirror headline, the growth
//   loop, the one-page view of the business, one anonymized transformation,
//   and an ask for the conversation. The page sells talking to Jonathan; the
//   Business Map is phase one of the paid build and is not named here.
// OWN-WORLD: Ivory / parchment / clay grounds with one committed amber band.
//   Bricolage Grotesque display + Schibsted Grotesk text (self-hosted
//   variable fonts). One board language for every figure: ivory board, ink
//   title bar, offset ink shadow, parchment chips, thin line icons.
// STORY: Name one piece of work that keeps getting stuck -> show how decisions
//   and details move through the growth loop -> map one recent example -> show what a reviewed
//   working record looks like -> invite the short intake.
// FIRST VIEWPORT: Full-bleed workshop photo, ivory overlap card bottom-left,
//   Jonathan recropped right of the card, one CTA.
// FORM: Lab lineage design-lab-composite-v12.html; copy approved in-session
//   2026-08-17 (Decision-Log entries: question-hero, conversation-first).
//   Case-study link intentionally absent until client clearance.

const personSchema = buildPersonSchema({
  description: 'Jonathan Malkin helps owner-led businesses turn knowledge trapped in people and scattered tools into systems their team and AI can actually use.',
  url: 'https://builtwithjon.com',
  knowsAbout: [
    'company brain systems',
    'business knowledge mapping',
    'AI-ready operations',
    'AI workshops in Austin',
  ],
});

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Jonathan Malkin',
  url: 'https://builtwithjon.com',
  description: 'Jonathan Malkin helps owner-led businesses turn knowledge trapped in people and scattered tools into systems their team and AI can actually use.',
};

const professionalServiceSchema = buildProfessionalServiceSchema({
  description: 'Jonathan Malkin helps owner-led businesses turn knowledge trapped in people and scattered tools into systems their team and AI can actually use. Austin-based, delivers anywhere.',
  founder: personSchema,
  makesOffer: [
    {
      '@type': 'Offer',
      name: 'A conversation, then a client-owned build',
      description: 'Start with a conversation about the project you keep putting off. If it is a fit, we build in phases. You own the finished system.',
      url: 'https://builtwithjon.com/#tell-me',
    },
  ],
});
---

<Base
  title="Business Knowledge Systems for Owner-Led Businesses | Austin, TX"
  description="I help owner-led businesses turn knowledge trapped in people and scattered tools into systems their team and AI can actually use."
  schema={personSchema}
>
  <JsonLd schema={websiteSchema} />
  <JsonLd schema={professionalServiceSchema} />

  <div class="h26-home2026">
    <section class="h26-hero">
      <div class="h26-img-holder">
        <picture>
          <source
            media="(min-width: 1021px)"
            type="image/webp"
            srcset="/home/austin-workshop-desktop-1200.webp 1200w, /home/austin-workshop-desktop-1600.webp 1600w, /home/austin-workshop-desktop-2000.webp 2000w, /home/austin-workshop-desktop-2400.webp 2400w, /home/austin-workshop-desktop-2880.webp 2880w, /home/austin-workshop-desktop-3200.webp 3200w, /home/austin-workshop-desktop-3600.webp 3600w"
            sizes="100vw"
          />
          <source
            media="(min-width: 1021px)"
            type="image/jpeg"
            srcset="/home/austin-workshop-desktop.jpg"
          />
          <source
            type="image/webp"
            srcset="/home/austin-workshop-900.webp 900w, /home/austin-workshop-1200.webp 1200w, /home/austin-workshop-1600.webp 1600w, /home/austin-workshop-2200.webp 2200w, /home/austin-workshop-2880.webp 2880w"
            sizes="100vw"
          />
          <img
            src="/home/austin-workshop.jpg"
            width="1600"
            height="1067"
            alt="Jonathan Malkin at the Capital Factory podium in Austin, the venue's gear-shaped stage wall behind him."
            fetchpriority="high"
          />
        </picture>
      </div>
      <div class="h26-over">
        <h1>Fix the work that keeps getting stuck.</h1>
        <p class="h26-lede">I help owner-led businesses fix handoffs, decisions, and repeat work that depend on one person remembering where everything lives.</p>
        <a class="h26-cta" href="#tell-me" data-track="cta:home-hero">Share an example</a>
      </div>
    </section>

    <section class="h26-mapband">
      <div class="h26-inner">
        <div>
          <h2>Start with the last time it happened.</h2>
          <p class="h26-body">Bring one recent example. We put the people, records, software, and decisions on one page so you can see where the work broke down before anyone talks about new software.</p>
          <a class="h26-cta" href="#tell-me" data-track="cta:home-picture">Find where it broke down</a>
        </div>
        <figure class="h26-board" aria-label="A one-page view of one piece of work: people, source records, systems, and the point where important details were lost.">
          <div class="h26-bar">One problem · one page</div>
          <div class="h26-diagram">
            <svg viewBox="0 0 640 352" role="img" aria-hidden="true">
              <defs>
                <marker id="map-la" viewBox="0 0 10 10" refX="7.5" refY="5" markerWidth="7" markerHeight="7" orient="auto">
                  <path d="M0,0 L10,5 L0,10 z" fill="#191E26"/>
                </marker>
              </defs>
              <g>
                <rect x="18" y="16" width="186" height="92" rx="12" fill="#F3ECDD" stroke="#191E26" stroke-width="1.6"/>
                <circle cx="48" cy="44" r="11" fill="none" stroke="#191E26" stroke-width="1.8"/>
                <path d="M30,78 q18,-16 36,0" fill="none" stroke="#191E26" stroke-width="1.8" stroke-linecap="round"/>
                <text x="78" y="48" class="h26-t-head">People</text>
                <text x="78" y="70" class="h26-t-sub">Who knew what</text>
              </g>
              <g>
                <rect x="227" y="16" width="186" height="92" rx="12" fill="#F3ECDD" stroke="#191E26" stroke-width="1.6"/>
                <path d="M247,52 h14 l8,-16 10,32 8,-16 h14" fill="none" stroke="#191E26" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <text x="287" y="48" class="h26-t-head">Source records</text>
                <text x="287" y="70" class="h26-t-sub">What was recorded</text>
              </g>
              <g>
                <rect x="436" y="16" width="186" height="92" rx="12" fill="#F3ECDD" stroke="#191E26" stroke-width="1.6"/>
                <rect x="456" y="38" width="28" height="10" rx="2" fill="none" stroke="#191E26" stroke-width="1.6"/>
                <rect x="456" y="54" width="28" height="10" rx="2" fill="none" stroke="#191E26" stroke-width="1.6"/>
                <text x="496" y="48" class="h26-t-head">Systems</text>
                <text x="496" y="70" class="h26-t-sub">Where work moved</text>
              </g>
              <path d="M111,108 v28" fill="none" stroke="#191E26" stroke-width="2.2" marker-end="url(#map-la)"/>
              <path d="M320,108 v28" fill="none" stroke="#191E26" stroke-width="2.2" marker-end="url(#map-la)"/>
              <path d="M529,108 v28" fill="none" stroke="#191E26" stroke-width="2.2" marker-end="url(#map-la)"/>
              <g>
                <rect x="18" y="154" width="604" height="176" rx="14" fill="#FBF8F1" stroke="#191E26" stroke-width="1.8"/>
                <text x="40" y="182" class="h26-t-head">What happened</text>
                <text x="40" y="204" class="h26-t-sub">Enough information to see the break and decide what should change.</text>
                <rect x="40" y="222" width="168" height="36" rx="8" fill="#F3ECDD" stroke="#D2C4A6"/>
                <text x="124" y="245" class="h26-t-chip">who knew</text>
                <rect x="220" y="222" width="168" height="36" rx="8" fill="#F3ECDD" stroke="#D2C4A6"/>
                <text x="304" y="245" class="h26-t-chip">which source</text>
                <rect x="400" y="222" width="168" height="36" rx="8" fill="#F3ECDD" stroke="#D2C4A6"/>
                <text x="484" y="245" class="h26-t-chip">who decides</text>
                <rect x="40" y="270" width="528" height="40" rx="8" fill="#FBF4EA" stroke="#C4392B" stroke-width="2" stroke-dasharray="6 4"/>
                <text x="56" y="295" class="h26-t-head" style="font-size:13px;fill:#C4392B;">Details got lost here</text>
                <text x="196" y="295" class="h26-t-sub">This is the smallest useful place to intervene.</text>
              </g>
            </svg>
          </div>
          <p class="h26-board-cap">First see the break. Then decide what is worth building.</p>
        </figure>
      </div>
    </section>

    <section class="h26-proof">
      <div class="h26-inner">
        <div class="h26-proof-head">
          <h2>The answer shouldn&rsquo;t be this hard to find.</h2>
          <p>The right version could be in any of them. First find it. Then see what changed and who owns the next step.</p>
        </div>
        <figure class="h26-knowledge-figure" aria-label="Information from email, spreadsheets, meeting notes, a shared drive, calls, and one person's memory is checked and turned into one clear working view.">
          <div class="h26-bar">From scattered to clear</div>
          <div class="h26-knowledge-canvas">
            <section class="h26-before" aria-label="The answer is spread across six places">
              <h3>The answer is somewhere in here</h3>
              <div class="h26-source-cloud">
                <span class="h26-source-card h26-email">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
                  <span><b>Email thread</b><small>three replies later</small></span>
                </span>
                <span class="h26-source-card h26-sheet">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M4 9h16M10 3v18M4 15h16"/></svg>
                  <span><b>Spreadsheet</b><small>which tab is current?</small></span>
                </span>
                <span class="h26-source-card h26-notes">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l3 3v15H6z"/><path d="M15 3v4h4M9 12h6M9 16h6"/></svg>
                  <span><b>Meeting notes</b><small>decision not assigned</small></span>
                </span>
                <span class="h26-source-card h26-drive">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h7l2 2h9v10H3z"/><path d="M3 7V5h7l2 2"/></svg>
                  <span><b>Shared drive</b><small>two versions</small></span>
                </span>
                <span class="h26-source-card h26-call">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3 4 5c0 8 7 15 15 15l2-3-5-3-2 2c-3-1-5-3-6-6l2-2z"/></svg>
                  <span><b>Client call</b><small>what did we agree?</small></span>
                </span>
                <span class="h26-source-card h26-memory">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-5 4-7 8-7s7 2 8 7"/></svg>
                  <span><b>One person knows</b><small>until they are unavailable</small></span>
                </span>
              </div>
            </section>

            <div class="h26-change-arrow" aria-hidden="true">
              <svg viewBox="0 0 76 48"><path d="M3 18h45V7l25 17-25 17V30H3z"/></svg>
            </div>

            <section class="h26-after" aria-label="One clear working view">
              <h3>One working view</h3>
              <div class="h26-view-row"><span>What we agreed</span><strong>source attached</strong></div>
              <div class="h26-view-row"><span>What changed</span><strong>latest version</strong></div>
              <div class="h26-view-row"><span>What is still open</span><strong>owner named</strong></div>
              <div class="h26-view-row"><span>What happens next</span><strong>owner + date</strong></div>
            </section>
          </div>
          <figcaption>You can see what happened, what is still open, and who owns the next step.</figcaption>
        </figure>
      </div>
    </section>

    <section class="h26-loopband">
      <div class="h26-inner">
        <div>
          <h2>Then the next round of work gets easier.</h2>
          <p class="h26-body">A clearer handoff helps delivery. What the team learns feeds the next sale. The point is to stop rebuilding the same answers every time the work comes around again.</p>
          <a class="h26-cta" href="#tell-me" data-track="cta:home-loop">Find peace of mind</a>
        </div>
        <figure class="h26-board" aria-label="The growth loop: sell and scope, hand off, deliver and adapt, learn and improve, repeat. Missing details slow the loop.">
          <div class="h26-bar">The growth loop</div>
          <div class="h26-loop-wrap">
            <svg viewBox="0 0 660 420" role="img" aria-hidden="true">
              <defs>
                <marker id="la" viewBox="0 0 10 10" refX="7.5" refY="5" markerWidth="7" markerHeight="7" orient="auto">
                  <path d="M0,0 L10,5 L0,10 z" fill="#191E26"/>
                </marker>
              </defs>
              <path d="M400,84 Q490,100 512,166" fill="none" stroke="#191E26" stroke-width="2.4" marker-end="url(#la)"/>
              <path d="M506,268 Q472,330 396,348" fill="none" stroke="#191E26" stroke-width="2.4" marker-end="url(#la)"/>
              <path d="M256,348 Q180,330 148,268" fill="none" stroke="#191E26" stroke-width="2.4" marker-end="url(#la)"/>
              <path d="M142,166 Q166,100 252,84" fill="none" stroke="#191E26" stroke-width="2.4" marker-end="url(#la)"/>
              <g>
                <rect x="246" y="34" width="168" height="74" rx="12" fill="#F3ECDD" stroke="#191E26" stroke-width="1.6"/>
                <text x="330" y="78" class="h26-loop-word">Sell</text>
              </g>
              <g>
                <rect x="468" y="176" width="170" height="74" rx="12" fill="#F3ECDD" stroke="#191E26" stroke-width="1.6"/>
                <text x="553" y="219" class="h26-loop-word">Handoff</text>
              </g>
              <g>
                <rect x="246" y="312" width="168" height="74" rx="12" fill="#F3ECDD" stroke="#191E26" stroke-width="1.6"/>
                <text x="330" y="357" class="h26-loop-word">Deliver</text>
              </g>
              <g>
                <rect x="32" y="176" width="152" height="74" rx="12" fill="#F3ECDD" stroke="#191E26" stroke-width="1.6"/>
                <text x="108" y="219" class="h26-loop-word">Learn</text>
              </g>
              <g>
                <rect x="240" y="179" width="180" height="62" rx="10" fill="#FBF4EA" stroke="#C4392B" stroke-width="2.2" stroke-dasharray="7 5"/>
                <text x="330" y="204" class="h26-t-jam">SCATTERED</text>
                <text x="330" y="225" class="h26-t-jam">KNOWLEDGE</text>
              </g>
              <g class="h26-loop-chip">
                <rect x="502" y="120" width="130" height="30" rx="7" fill="#FBF8F1" stroke="#D2C4A6"/>
                <text x="567" y="139" class="h26-t-chip">client decision</text>
                <rect x="418" y="368" width="142" height="30" rx="7" fill="#FBF8F1" stroke="#D2C4A6"/>
                <text x="489" y="387" class="h26-t-chip">delivery lesson</text>
                <rect x="548" y="290" width="108" height="30" rx="7" fill="#FBF8F1" stroke="#D2C4A6"/>
                <text x="602" y="309" class="h26-t-chip">handoff note</text>
                <path d="M566,146 Q556,162 550,176" fill="none" stroke="#9A917C" stroke-width="1.6" stroke-dasharray="4 4"/>
                <path d="M470,366 Q446,356 420,350" fill="none" stroke="#9A917C" stroke-width="1.6" stroke-dasharray="4 4"/>
                <path d="M600,288 Q592,270 580,254" fill="none" stroke="#9A917C" stroke-width="1.6" stroke-dasharray="4 4"/>
              </g>
            </svg>
          </div>
          <p class="h26-board-cap">Scattered knowledge makes the team rebuild the answer at every step.</p>
        </figure>
      </div>
    </section>

    <section class="h26-finale">
      <div class="h26-img-holder">
        <picture>
          <source
            media="(min-width: 1021px)"
            type="image/webp"
            srcset="/home/austin-portrait-desktop-1200.webp 1200w, /home/austin-portrait-desktop-1600.webp 1600w, /home/austin-portrait-desktop-2000.webp 2000w, /home/austin-portrait-desktop-2400.webp 2400w, /home/austin-portrait-desktop-2880.webp 2880w, /home/austin-portrait-desktop-3200.webp 3200w, /home/austin-portrait-desktop-3600.webp 3600w"
            sizes="100vw"
          />
          <source
            media="(min-width: 1021px)"
            type="image/jpeg"
            srcset="/home/austin-portrait-desktop.jpg"
          />
          <source
            type="image/webp"
            srcset="/home/austin-portrait-900.webp 900w, /home/austin-portrait-1200.webp 1200w, /home/austin-portrait-1600.webp 1600w, /home/austin-portrait-2200.webp 2200w, /home/austin-portrait-2880.webp 2880w"
            sizes="100vw"
          />
          <img
            src="/home/austin-portrait.jpg"
            width="1600"
            height="1067"
            alt="Jonathan Malkin speaking onstage in Austin."
            loading="lazy"
          />
        </picture>
      </div>
      <div class="h26-over">
        <h2>Resolve the thorny issue before it repeats.</h2>
        <p class="h26-sub">Bring one recent example: what happened, where the details lived, and what should have gone differently. I reply personally. If I can help, the next step is a call.</p>
        <a class="h26-cta" href="#tell-me" data-track="cta:home-finale">Resolve my thorny issue</a>
      </div>
    </section>

    <section class="h26-intake" id="tell-me" aria-labelledby="tellme-h">
      <div class="h26-inner">
        <h2 id="tellme-h">Share one recent example.</h2>
        <div class="h26-formboard">
          <div class="h26-bar">Short intake</div>
          <div class="h26-formwrap">
            <form
              action="/api/subscribe"
              method="POST"
              class="intake bm-step1"
              data-track-form="business-map"
            >
              <p class="intake-progress">Step 1 of 2 &middot; Email first</p>
              <input type="hidden" name="_subject" value="Website intake (step 1)" />
              <input type="hidden" name="inquiry_type" value="business-map-intake" />
              <input type="hidden" name="form_id" value="business-map" />
              <input type="hidden" name="framing" value="" />
              <input type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" class="form-honeypot" />
              <div class="form-group">
                <label for="bm-email">Email</label>
                <input type="email" id="bm-email" name="email" required class="form-input" autocomplete="email" inputmode="email" spellcheck="false" />
                <p class="intake-hint">Three questions follow so I can give you a useful reply.</p>
              </div>
              <div class="form-group">
                <label for="bm-name">Name <span class="form-optional">(optional)</span></label>
                <input type="text" id="bm-name" name="name" class="form-input" autocomplete="name" />
              </div>
              <button type="submit" class="form-submit">Submit</button>
              <p class="intake-status" hidden role="status"></p>
            </form>

            <template id="bm-step2-template">
              <form
                action="/api/subscribe"
                method="POST"
                class="intake bm-step2"
                data-track-form="business-map-details"
              >
                <p class="intake-done" role="status">Got it. Three questions and you're done.</p>
                <p class="intake-progress">Step 2 of 2 &middot; Three questions</p>
                <input type="hidden" name="_subject" value="Website intake (step 2)" />
                <input type="hidden" name="inquiry_type" value="business-map-intake" />
                <input type="hidden" name="form_id" value="business-map-details" />
                <input type="hidden" name="framing" value="" />
                <input type="hidden" name="email" value="" />
                <input type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" class="form-honeypot" />
                <div class="form-group">
                  <label for="bm-blocked-project">What keeps breaking down or taking longer than it should?</label>
                  <textarea id="bm-blocked-project" name="blocked_project" rows="3" required maxlength="2000" class="form-input"></textarea>
                </div>
                <fieldset class="form-group">
                  <legend>Does one person know where most of the information lives?</legend>
                  <div class="yesno">
                    <label><input type="radio" name="key_person" value="Yes" required /> Yes</label>
                    <label><input type="radio" name="key_person" value="No" /> No</label>
                  </div>
                </fieldset>
                <fieldset class="form-group">
                  <legend>Is anyone on your team already fixing it?</legend>
                  <div class="yesno">
                    <label><input type="radio" name="already_building" value="Yes" required /> Yes</label>
                    <label><input type="radio" name="already_building" value="No" /> No</label>
                  </div>
                </fieldset>
                <button type="submit" class="form-submit">Send the intake</button>
                <p class="intake-status" hidden role="status"></p>
              </form>
            </template>
            <div class="bm-step2-slot"></div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  const step1 = document.querySelector('.bm-step1');
  const step2Template = document.getElementById('bm-step2-template');
  const step2Slot = document.querySelector('.bm-step2-slot');
  const FRAMINGS = ['product', 'marketing', 'onboarding', 'exit', 'construction'];
  const framingParam = new URLSearchParams(location.search).get('f');
  const framing = FRAMINGS.includes(framingParam) ? framingParam : '';

  function applyFraming(scope) {
    scope.querySelectorAll('input[name="framing"]').forEach((el) => {
      if (framing) el.value = framing;
      else el.remove();
    });
  }
  applyFraming(document);

  function statusEl(form) {
    return form.querySelector('.intake-status');
  }

  function showStatus(form, message) {
    const status = statusEl(form);
    if (status) {
      status.textContent = message;
      status.hidden = false;
    }
  }

  async function submitIntake(form) {
    const response = await fetch(form.action, {
      method: 'POST',
      body: new FormData(form),
      headers: { Accept: 'application/json' },
    });
    const result = await response.json().catch(() => ({}));
    if (!response.ok || !result.ok) throw new Error(result.error || 'intake_failed');
    return result;
  }

  function wireStep2(email) {
    if (!step2Template || !step2Slot || step2Slot.querySelector('form')) return;
    step2Slot.appendChild(step2Template.content.cloneNode(true));
    const step2 = step2Slot.querySelector('.bm-step2');
    if (!step2) return;
    const emailField = step2.querySelector('input[name="email"]');
    if (emailField) emailField.value = email;
    applyFraming(step2);
    if (window.bwjInjectAttribution) window.bwjInjectAttribution(step2Slot);

    step2.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!step2.checkValidity()) {
        step2.reportValidity();
        return;
      }
      const button = step2.querySelector('button[type="submit"]');
      if (button) {
        button.disabled = true;
        button.textContent = 'Sending...';
      }
      try {
        await submitIntake(step2);
        if (window.bwjTrack) window.bwjTrack('business-map:success');
        step2.querySelectorAll('.form-group, button[type="submit"], .intake-progress, .intake-done').forEach((el) => {
          el.hidden = true;
        });
        showStatus(step2, 'Got it. I will reply to the email you gave me.');
      } catch (err) {
        showStatus(step2, 'That did not go through. Email jonathan@builtwithjon.com and I will follow up.');
        if (button) {
          button.disabled = false;
          button.textContent = 'Send the intake';
        }
      }
    });

    step2.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    const firstField = step2.querySelector('textarea');
    if (firstField) firstField.focus({ preventScroll: true });
  }

  step1?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!step1.checkValidity()) {
      step1.reportValidity();
      return;
    }
    const button = step1.querySelector('button[type="submit"]');
    if (button) {
      button.disabled = true;
      button.textContent = 'Saving...';
    }
    try {
      await submitIntake(step1);
      if (window.bwjTrack) window.bwjTrack('business-map:capture');
      const email = step1.querySelector('input[name="email"]')?.value || '';
      step1.hidden = true;
      wireStep2(email);
    } catch (err) {
      showStatus(step1, 'That did not go through. Email jonathan@builtwithjon.com and I will follow up.');
      if (button) {
        button.disabled = false;
        button.textContent = 'Continue to the questions';
      }
    }
  });
</script>

