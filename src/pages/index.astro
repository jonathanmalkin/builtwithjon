---
// Home, October 2026 revamp. Structure chosen by Jonathan on October 6 and
// simplified at 13:00 the same day: the quote hero, the hands-on walk-through,
// then one band per audience (your company; the group you gather), Jonathan
// briefly, the form. Workshop particulars live on /workshops/.
// Site map: Workspace/04-Marketing/Website/2026-10-05-workshops-led-update.md
// Pages approved as built by Jonathan on October 6, 2026. Nothing deploys without his word.
import Odl from '../layouts/Odl.astro';
import MessageForm from '../components/MessageForm.astro';
import JsonLd from '../components/JsonLd.astro';
import { buildPersonSchema, buildProfessionalServiceSchema } from '../lib/schema.js';
import { SITE, WORKSHOPS, STEPS, BIO } from '../data/odl';

const description = 'Hands-on AI workshops in Austin for owners, executives and their teams. Work on a real task from your own week and leave with something that works.';
const personSchema = buildPersonSchema({
  description: BIO.medium,
  url: `${SITE.url}/about/`,
  knowsAbout: ['AI workshops for business owners', 'AI training for executives and teams', 'personal AI assistants', 'applied AI in small business'],
});
const websiteSchema = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.company, url: SITE.url, description };
const serviceSchema = buildProfessionalServiceSchema({
  name: SITE.company,
  description,
  founder: personSchema,
  makesOffer: WORKSHOPS.map((w) => ({ '@type': 'Offer', name: w.name, description: w.summary, url: `${SITE.url}/workshops/#workshops` })),
});
---

<Odl title={`${SITE.person}, ${SITE.title}`} titleSuffix={true} description={description} schema={personSchema}>
  <JsonLd schema={websiteSchema} />
  <JsonLd schema={serviceSchema} />

  <section class="hero home-hero" aria-labelledby="hero-h">
    <picture>
      <source media="(min-width: 861px)" type="image/webp" srcset="/home/austin-workshop-desktop-1600.webp 1600w, /home/austin-workshop-desktop-2000.webp 2000w, /home/austin-workshop-desktop-2400.webp 2400w, /home/austin-workshop-desktop-2880.webp 2880w" sizes="max(100vw, 1980px)" />
      <source type="image/webp" srcset="/home/austin-workshop-640.webp 640w, /home/austin-workshop-900.webp 900w, /home/austin-workshop-1200.webp 1200w, /home/austin-workshop-1600.webp 1600w" sizes="100vw" />
      <img src="/home/austin-workshop.jpg" width="1600" height="1067" alt="Jonathan Malkin teaching from the podium at a workshop in Austin." fetchpriority="high" />
    </picture>
    <div class="hero-card">
      <h1 id="hero-h">&ldquo;{SITE.cue}&rdquo;</h1>
      <p class="lede">I&rsquo;m Jonathan Malkin. I teach owners, executives and their teams to solve real business problems with AI, in hands-on workshops where you work on your own business.</p>
      <div class="actions">
        <a class="btn" href="/workshops/" data-track="cta:home-hero">See the workshops <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="sec band-parch" aria-labelledby="room-h">
    <div class="inner">
      <div class="split" style="padding:0">
        <div>
          <h2 id="room-h">Hands-on AI workshops for owners, executives and their teams</h2>
          <p class="lede" style="margin-top:16px">You work on a real task from your own week, on your own laptop, with help beside you. No slides about the future of work. Ninety minutes, and you leave with something that works.</p>
        </div>
        <figure class="photo" style="aspect-ratio:3/2">
          <picture>
            <source type="image/webp" srcset="/home/room-working-800.webp 800w, /home/room-working-1200.webp 1200w, /home/room-working-1800.webp 1800w" sizes="(max-width: 700px) 92vw, min(45vw, 590px)" />
            <img src="/home/room-working.jpg" width="1600" height="1067" loading="lazy" alt="A workshop in Austin, seen from the back of the room: people along a long table working on their own laptops while Jonathan Malkin teaches at the screen." />
          </picture>
        </figure>
      </div>
      <ol class="steps" style="margin-top:clamp(36px,4vw,56px)">
        {STEPS.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec" aria-labelledby="co-h">
    <div class="inner duo">
      <figure class="photo" style="aspect-ratio:4/3">
        <picture>
          <source type="image/webp" srcset="/home/austin-hero-600.webp 600w, /home/austin-hero-900.webp 900w, /home/austin-hero-1082.webp 1082w" sizes="(max-width: 700px) 92vw, min(45vw, 590px)" />
          <img src="/home/austin-hero.jpg" width="1082" height="1360" loading="lazy" alt="Jonathan Malkin speaking to a room, holding a presentation clicker." style="object-position:50% 20%" />
        </picture>
      </figure>
      <div>
        <h2 id="co-h">For your company</h2>
        <p class="lede">You own or run the business, and the team has tried AI. Bring a workshop in: hands-on sessions where each person builds on their own work, a leadership session for the people who run the business, and a technical one for IT. When something needs building afterwards, I build it.</p>
        <div class="actions">
          <a class="btn" href="/workshops/" data-track="cta:home-company">See the workshops <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec band-amber" aria-labelledby="host-h">
    <div class="inner duo">
      <div>
        <h2 id="host-h">For your members</h2>
        <p class="lede">You run a chamber, an association, a peer group, a co-working community or a portfolio of companies, and your people are asking about AI. I bring a session that is useful to them and reflects well on you.</p>
        <div class="actions">
          <a class="btn" href="/host-a-workshop/" data-track="cta:home-host">Bring a workshop to your members <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <figure class="photo" style="aspect-ratio:4/3">
        <picture>
          <source type="image/webp" srcset="/home/podium-800.webp 800w, /home/podium-1200.webp 1200w, /home/podium-1800.webp 1800w" sizes="(max-width: 700px) 92vw, min(45vw, 590px)" />
          <img src="/home/podium.jpg" width="1600" height="1067" loading="lazy" alt="Jonathan Malkin at the podium at Capital Factory in Austin, speaking to a seated audience." style="object-position:50% 35%" />
        </picture>
      </figure>
    </div>
  </section>

  <section class="sec" aria-labelledby="jm-h">
    <div class="inner portrait">
      <figure class="photo">
        <img src="/home/austin-portrait-900.webp" width="900" height="600" loading="lazy" alt="Jonathan Malkin speaking at an event in Austin, wearing a name badge and a lapel microphone." />
      </figure>
      <div>
        <h2 id="jm-h">Jonathan Malkin</h2>
        <p class="lede" style="margin-top:14px">More than twenty years in enterprise technology, helping large companies actually use what they bought. Now I do the same for owners and their teams, in a room, on their own work. Based in Austin, working as Open Door Learning.</p>
        <div class="actions" style="margin-top:22px">
          <a class="go" href="/about/">About Jonathan <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <div class="band-parch" id="tell-me">
    <MessageForm kind="workshop" id="message" heading="Curious? Start with a message" intro="Tell me what you have tried, what you want AI to do in your business, or about the people you have in mind. I will suggest where to start." />
  </div>
</Odl>

<style>
  /* Desktop hero: the photo is drawn a quarter larger than the hero and placed
     so Jonathan's face (55.5% across the 2.4:1 frame) sits at the centre of
     the space to the right of the card, clamped so the photo always covers. */
  @media(min-width:861px){
    .home-hero{--s:max(calc(var(--h) * 3),100vw)}
    .home-hero picture{overflow:hidden}
    .home-hero picture img{position:absolute;width:var(--s);height:auto;aspect-ratio:2.4;object-fit:cover;object-position:50% 50%;top:calc(var(--h) * .39 - var(--s) * .1458);left:clamp(calc(100vw - var(--s)),calc((max(5vw,calc((100vw - 1240px) / 2)) + min(620px,47vw) + 100vw) / 2 - var(--s) * .555),0px)}
  }
</style>
