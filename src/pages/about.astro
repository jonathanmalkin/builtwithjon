---
// About, October 2026 revamp. The "Jonathan first" page, for both audiences.
// Order decided October 6: portrait, story, Why Open Door Learning, where to
// go next, form. First person; the former name appears nowhere on the site.
// Site map: Workspace/04-Marketing/Website/2026-10-05-workshops-led-update.md
// Copy is draft until Jonathan approves it page by page.
import Odl from '../layouts/Odl.astro';
import MessageForm from '../components/MessageForm.astro';
import { buildPersonSchema } from '../lib/schema.js';
import { SITE, BIO } from '../data/odl';

const description = 'Jonathan Malkin is an AI educator and builder in Austin, Texas. Twenty years in enterprise technology, now teaching owners, executives and their teams hands-on.';
const personSchema = buildPersonSchema({
  description: BIO.medium,
  url: `${SITE.url}/about/`,
  knowsAbout: ['AI workshops for business owners', 'AI training for executives and teams', 'enterprise technology adoption', 'personal AI assistants', 'applied AI in small business'],
});
---

<Odl title={`About ${SITE.person}`} description={description} image="/home/austin-portrait.jpg" imageWidth={1600} imageHeight={1067} schema={personSchema}>

  <section class="sec band-parch" aria-labelledby="hero-h">
    <div class="inner split media-left" style="padding:0">
      <div>
        <h1 id="hero-h">{SITE.person}</h1>
        <p class="role">{SITE.titleLower}</p>
        <p class="lede" style="margin-bottom:16px">{SITE.positioning}</p>
        <p class="cap" style="margin-bottom:26px">20+ years in enterprise technology. Based in {SITE.city}. Working as {SITE.company}.</p>
        <div class="actions">
          <a class="btn" href="/workshops/" data-track="cta:about-hero">See the workshops <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <figure class="photo" style="aspect-ratio:3/2">
        <picture>
          <source type="image/webp" srcset="/home/austin-portrait-900.webp 900w, /home/austin-portrait-1200.webp 1200w, /home/austin-portrait-1600.webp 1600w, /home/austin-portrait-2200.webp 2200w" sizes="(max-width: 860px) 100vw, 52vw" />
          <img src="/home/austin-portrait.jpg" width="1600" height="1067" fetchpriority="high" alt="Jonathan Malkin speaking at an event in Austin, wearing a name badge and a lapel microphone." />
        </picture>
      </figure>
    </div>
  </section>

  <section class="sec" aria-labelledby="story-h">
    <div class="inner narrow">
      <h2 id="story-h">Twenty years of getting people to use the thing</h2>
      <div class="story">
        <p>I have spent more than twenty years in enterprise technology. Most of that time went to one problem: getting large companies to actually use what they bought. I did that work across finance, HR, IT, operations, sales and marketing.</p>
        <p>Eight of those years were at Automation Anywhere, through the wave of automation software. The hard part was never the software. It was the people, and the handoffs between them.</p>
        <p>In June 2025 I went independent. Now I teach owners, executives and their teams, based in Austin, because the same gap exists in a twelve-person company as in a twelve-thousand-person one. The smaller company just has less cover.</p>
      </div>
    </div>
  </section>

  <section class="sec band-parch" aria-labelledby="odl-h">
    <div class="inner narrow">
      <h2 id="odl-h">Why Open Door Learning</h2>
      <div class="door-line">
        <img src="/brand/odl-symbol.svg" width="34" height="48" alt="" loading="lazy" />
        <p class="pull">Anyone can walk in and start where they are. Nobody is behind.</p>
      </div>
      <div class="story">
        <p>The name is the promise. Whether you have never opened ChatGPT or you use it every day, the session meets you there and takes you one useful step further.</p>
        <p>The door stays open afterwards, too. You leave with the materials, so you can repeat on Monday what you built in the room, without me beside you.</p>
      </div>
    </div>
  </section>

  <div class="band-clay">
    <MessageForm kind="contact" id="message" heading="Say hello" intro="A question, an introduction, or a room you think I should know about." track="contact" />
  </div>
</Odl>

<style>
  .role{font:600 clamp(1.3rem,2vw,1.7rem)/1.2 var(--disp);letter-spacing:-.015em;color:var(--copper);margin:-6px 0 20px}
  .story{margin-top:24px}
  .story p{font-size:1.1rem;line-height:1.6}
  .story p+p{margin-top:16px}
  .story a{color:var(--ink);font-weight:600;text-decoration:underline}
</style>
