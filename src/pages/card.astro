---
import Base from '../layouts/Base.astro';
---

<Base
  title="Jonathan Malkin"
  description="Message Jonathan Malkin or connect on LinkedIn."
  noindex
  bare
>
  <div class="card-page">
    <header class="card-id">
      <img
        class="card-photo"
        src="/images/jonathan-malkin.jpg"
        width="800"
        height="800"
        alt="Jonathan Malkin"
      />
      <div>
        <p class="card-name">Jonathan Malkin</p>
        <p class="card-role">AI Operator &middot; Workshop Facilitator</p>
        <p class="card-city">Austin, Texas</p>
      </div>
    </header>

    <a
      class="card-linkedin"
      href="https://linkedin.com/in/jonathanmalkin"
      rel="me noopener"
      target="_blank"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      <span>Connect on LinkedIn</span>
    </a>

    <form
      action="/api/contact"
      method="POST"
      class="card-form"
      data-track-form="contact"
    >
      <input type="hidden" name="_subject" value="Business card scan — builtwithjon.com/card" />
      <input type="hidden" name="inquiry_type" value="card" />
      <input type="hidden" name="name" value="Card scan" />
      <input type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" class="card-honeypot" />

      <div class="card-field">
        <label for="card-email">Your email</label>
        <input
          type="email"
          id="card-email"
          name="email"
          required
          autocomplete="email"
          inputmode="email"
          autocapitalize="off"
          spellcheck="false"
          class="form-input"
        />
      </div>

      <div class="card-field card-field-grow">
        <label for="card-message">Message</label>
        <textarea
          id="card-message"
          name="message"
          required
          class="form-input"
          placeholder="Where we met, and what you want to talk about."
        ></textarea>
      </div>

      <button type="submit" class="card-send">Send</button>
      <p class="card-status" hidden role="status"></p>
    </form>

    <p class="card-fallback">
      <a href="mailto:jonathan@builtwithjon.com">jonathan@builtwithjon.com</a>
    </p>
  </div>

  <style>
    .card-page {
      display: flex;
      flex-direction: column;
      margin: 0 auto;
      max-width: 30rem;
      min-height: 100vh;
      min-height: 100dvh;
      padding: 20px;
    }

    .card-id {
      align-items: center;
      border-bottom: 1px solid var(--ucl-ink);
      display: flex;
      gap: 14px;
      padding-bottom: 16px;
    }

    .card-photo {
      border: 1px solid var(--ucl-ink);
      flex: none;
      height: 66px;
      object-fit: cover;
      width: 66px;
    }

    .card-name {
      font-family: var(--ucl-serif);
      font-size: clamp(1.65rem, 4vw, 2.45rem);
      font-weight: 500;
      letter-spacing: -0.02em;
      line-height: 1.08;
      margin: 0;
    }

    .card-role,
    .card-city {
      color: var(--ucl-ink-2);
      line-height: 1.35;
      margin: 2px 0 0;
    }

    .card-city {
      color: var(--ucl-ink-3);
    }

    .card-linkedin {
      align-items: center;
      background: var(--ucl-paper-card);
      border: 1px solid var(--ucl-ink);
      border-radius: var(--ucl-r-md);
      color: var(--ucl-ink);
      display: flex;
      font-family: var(--ucl-mono);
      font-size: 11px;
      font-weight: 500;
      gap: 10px;
      justify-content: center;
      letter-spacing: 0.08em;
      margin-top: 16px;
      min-height: 48px;
      text-decoration: none;
      text-transform: uppercase;
    }

    .card-linkedin:hover {
      background: var(--ucl-ink);
      color: var(--ucl-paper);
      text-decoration: none;
    }

    .card-form {
      display: flex;
      flex: 1;
      flex-direction: column;
      margin-top: 14px;
      min-height: 0;
    }

    .card-field {
      display: flex;
      flex-direction: column;
      margin-bottom: 12px;
    }

    .card-field-grow {
      flex: 1;
      min-height: 0;
    }

    .card-field label {
      font-family: var(--ucl-mono);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.08em;
      margin-bottom: 6px;
      text-transform: uppercase;
    }

    .card-page .form-input {
      background: var(--ucl-paper-card);
      border-color: var(--ucl-line-2);
      border-radius: var(--ucl-r-md);
      font-size: 16px;
      padding: 12px;
    }

    .card-page input.form-input {
      min-height: 48px;
    }

    /* Takes whatever height the phone has left, so the page always ends on the
       Send button with no scroll. */
    .card-page textarea.form-input {
      flex: 1;
      min-height: 3.5rem;
      resize: none;
    }

    .card-send {
      background: var(--ucl-ink);
      border: 1px solid var(--ucl-ink);
      border-radius: var(--ucl-r-md);
      color: var(--ucl-paper);
      cursor: pointer;
      font-family: var(--ucl-mono);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.08em;
      min-height: 48px;
      text-transform: uppercase;
      width: 100%;
    }

    .card-send:hover {
      background: var(--color-accent-hover);
    }

    .card-send[disabled] {
      cursor: progress;
      opacity: 0.6;
    }

    .card-status {
      line-height: 1.4;
      margin: 12px 0 0;
    }

    .card-fallback {
      margin: 14px 0 0;
      text-align: center;
    }

    .card-fallback a {
      color: var(--ucl-ink-2);
      font-size: 11px;
      font-family: var(--ucl-mono);
      letter-spacing: 0.08em;
    }

    .card-honeypot {
      height: 1px;
      left: -10000px;
      opacity: 0;
      pointer-events: none;
      position: absolute;
      width: 1px;
    }

    /* Once sent, the form is replaced by its own status line. */
    .card-form.is-sent .card-field,
    .card-form.is-sent .card-send {
      display: none;
    }

    .card-form.is-sent {
      justify-content: center;
    }

    /* Short viewports (small phones, landscape, browser chrome eating the
       screen). Both actions must still land without a scroll. */
    @media (max-height: 560px) {
      .card-page {
        padding: 12px;
      }

      .card-role,
      .card-city {
        line-height: 1.25;
      }

      .card-field {
        margin-bottom: 10px;
      }

      .card-field label {
        margin-bottom: 4px;
      }

      .card-photo {
        height: 52px;
        width: 52px;
      }

      .card-id {
        padding-bottom: 12px;
      }

      .card-name {
        font-size: 1.35rem;
        line-height: 1.12;
      }

      .card-linkedin {
        margin-top: 12px;
      }

      .card-page textarea.form-input {
        min-height: 2.75rem;
      }

      .card-fallback {
        margin-top: 10px;
      }
    }

    /* Landscape phones have no vertical room to stack. Put who-I-am and the
       LinkedIn tap beside the form instead of above it. */
    @media (max-height: 500px) and (orientation: landscape) {
      .card-page {
        column-gap: 20px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
        grid-template-rows: auto auto 1fr;
        max-width: 46rem;
      }

      .card-id {
        border-bottom: none;
        grid-area: 1 / 1;
        padding-bottom: 0;
      }

      .card-linkedin {
        grid-area: 2 / 1;
      }

      .card-fallback {
        align-self: start;
        grid-area: 3 / 1;
        text-align: left;
      }

      .card-form {
        grid-area: 1 / 2 / 4 / 3;
        margin-top: 0;
      }
    }
  </style>
</Base>

<script>
  const form = document.querySelector('.card-form') as HTMLFormElement | null;
  const status = form?.querySelector('.card-status') as HTMLParagraphElement | null;
  const nameField = form?.querySelector('input[name="name"]') as HTMLInputElement | null;
  const emailField = form?.querySelector('input[name="email"]') as HTMLInputElement | null;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) return form.reportValidity();

    // The contact endpoint requires a name; this page only asks for email and
    // message, so label the sender by their address and where they came from.
    if (nameField && emailField) {
      const local = emailField.value.trim().split('@')[0];
      nameField.value = `${local || 'Someone'} (card scan)`.slice(0, 120);
    }

    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (button) button.disabled = true;

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error('card_contact_failed');
      form.classList.add('is-sent');
      if (status) {
        status.textContent = 'Got it. I will reply to that address.';
        status.hidden = false;
      }
    } catch {
      if (status) {
        status.textContent = 'That did not go through. Email jonathan@builtwithjon.com instead.';
        status.hidden = false;
      }
      if (button) button.disabled = false;
    }
  });
</script>
