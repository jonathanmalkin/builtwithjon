---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Personal AI Assistant Workshop Slides"
  description="Slides from the Personal AI Assistant workshop: daily briefs, meeting preparation and keeping track of next steps."
  bare
>
  <div class="pa-wrap">
    <h1 class="sr-only">Personal AI Assistant workshop slides</h1>
    <a class="back" href="/speaking/#decks">Back to talks and decks</a>
    <iframe
      src="/workshops/decks/personal-assistant"
      title="Personal AI Assistant workshop slides"
    ></iframe>
  </div>
</Base>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .pa-wrap { height: 100vh; display: grid; grid-template-rows: auto 1fr; background: #1f1713; }
  .back {
    color: #fbf6ec;
    font: 600 0.95rem/1 system-ui, sans-serif;
    padding: 12px 18px;
    text-decoration: none;
  }
  .back:hover { color: #fff; }
  iframe { width: 100%; height: 100%; border: 0; background: #fbf6ec; }
</style>

<style is:global>
  body { max-width: none !important; padding: 0 !important; background: #1f1713 !important; }
</style>
