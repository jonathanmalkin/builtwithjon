---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Personal AI Assistant Workshop Slides"
  description="Slides from the Personal AI Assistant workshop: daily briefs, meeting preparation and keeping track of next steps."
  bare
>
  <div class="pa-wrap">
    <a class="back" href="/workshops/">Back to workshops</a>
    <iframe
      src="/workshops/decks/personal-assistant.html"
      title="Personal AI Assistant workshop slides"
    ></iframe>
  </div>
</Base>

<style>
  .pa-wrap { height: 100vh; display: grid; grid-template-rows: auto 1fr; background: #1f1713; }
  .back {
    color: #fbf6ec;
    font: 600 0.95rem/1 system-ui, sans-serif;
    padding: 12px 18px;
    text-decoration: none;
  }
  .back:hover { color: #fff; }
  iframe { width: 100%; height: 100%; border: 0; background: #fbf6ec; }
</style>

<style is:global>
  body { max-width: none !important; padding: 0 !important; background: #1f1713 !important; }
</style>
