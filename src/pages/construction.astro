---
import Base from '../layouts/Base.astro';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/schibsted-grotesk';

// DIRECTION CONTRACT (2026-08-29)
// ADAPTATION: The homepage's approved 2026 visual and interaction system,
//   applied to the three provisional GC workflow use cases. This is not a
//   separate construction brand or a claim of GC specialization.
// STORY: Recognize the stuck work -> inspect three concrete GC workflows ->
//   carry a usable record through the project lifecycle -> share one example.
// ACTION: Stage-specific CTAs route to the on-page construction intake.

const description =
  'For owner-led general contractors: examine one recent project handoff, subcontractor buyout, or change to find where the team lost a usable record.';
---

<Base
  title="Construction Workflows for General Contractors"
  description={description}
>
  <div class="c26-construction">
    <section class="c26-hero" aria-labelledby="construction-title">
      <div class="c26-img-holder">
        <picture>
          <source
            media="(min-width: 1021px)"
            type="image/webp"
            srcset="/home/austin-workshop-desktop-1200.webp 1200w, /home/austin-workshop-desktop-1600.webp 1600w, /home/austin-workshop-desktop-2000.webp 2000w, /home/austin-workshop-desktop-2400.webp 2400w, /home/austin-workshop-desktop-2880.webp 2880w, /home/austin-workshop-desktop-3200.webp 3200w, /home/austin-workshop-desktop-3600.webp 3600w"
            sizes="100vw"
          />
          <source media="(min-width: 1021px)" type="image/jpeg" srcset="/home/austin-workshop-desktop.jpg" />
          <source
            type="image/webp"
            srcset="/home/austin-workshop-900.webp 900w, /home/austin-workshop-1200.webp 1200w, /home/austin-workshop-1600.webp 1600w, /home/austin-workshop-2200.webp 2200w, /home/austin-workshop-2880.webp 2880w"
            sizes="100vw"
          />
          <img
            src="/home/austin-workshop.jpg"
            width="1600"
            height="1067"
            alt="Jonathan Malkin at the Capital Factory podium in Austin, the venue's gear-shaped stage wall behind him."
            fetchpriority="high"
          />
        </picture>
      </div>
      <div class="c26-over">
        <h1 id="construction-title">Fix the construction work that keeps getting stuck.</h1>
        <p class="c26-lede">For commercial GC owners and operating leaders. Start with a recent project handoff, subcontractor buyout, or change.</p>
        <a class="c26-cta" href="#tell-me" data-track="cta:construction-hero">Share a recent example</a>
      </div>
    </section>

    <section class="c26-proof" aria-labelledby="workflow-board-title">
      <div class="c26-inner">
        <figure class="c26-workflow-board" aria-labelledby="workflow-board-title">
          <figcaption id="workflow-board-title" class="c26-bar">Three construction workflows</figcaption>
          <div class="c26-workflow-list">
              <article class="c26-workflow-lane">
                <h3>Estimate to project handoff</h3>
                <svg viewBox="0 0 340 142" aria-hidden="true">
                  <defs><marker id="c26-handoff-arrow" viewBox="0 0 10 10" refX="7.5" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#191e26" /></marker></defs>
                  <path d="M22 26 h70 v84 h-70 z M34 48 h46 M34 66 h34 M34 84 h40" class="c26-scene-line" />
                  <path d="M108 68 H148 M192 68 H226" class="c26-flow-line" marker-end="url(#c26-handoff-arrow)" />
                  <text x="170" y="91" class="c26-gap-label">SCOPE + OWNERS?</text>
                  <circle cx="260" cy="54" r="18" class="c26-scene-line" />
                  <circle cx="308" cy="54" r="18" class="c26-scene-line" />
                  <path d="M236 108 q24-30 48 0 M284 108 q24-30 48 0" class="c26-scene-line" />
                  <text x="57" y="133" class="c26-scene-label">ESTIMATE</text>
                  <text x="284" y="133" class="c26-scene-label">PROJECT TEAM</text>
                </svg>
                <p>Could the PM and superintendent see the agreed scope, exclusions, budget, open decisions, and owners without chasing the estimator?</p>
              </article>
              <article class="c26-workflow-lane">
                <h3>Subcontractor buyout and scope control</h3>
                <svg viewBox="0 0 340 142" aria-hidden="true">
                  <defs><marker id="c26-buyout-arrow" viewBox="0 0 10 10" refX="7.5" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#191e26" /></marker></defs>
                  <path d="M18 36 h58 v72 h-58 z M35 26 h58 v72 h-17 M52 18 h58 v72 h-17" class="c26-scene-line" />
                  <path d="M118 68 H148 M192 68 H226" class="c26-flow-line" marker-end="url(#c26-buyout-arrow)" />
                  <text x="170" y="87" class="c26-gap-label"><tspan x="170">EXCLUSIONS +</tspan><tspan x="170" dy="12">REVISIONS?</tspan></text>
                  <path d="M244 30 h76 v78 h-76 z M256 50 h52 M256 68 h52 M256 86 h34" class="c26-scene-line" />
                  <circle cx="306" cy="91" r="22" class="c26-award-seal" />
                  <path d="M297 91 l7 8 12-16" class="c26-check-line" />
                  <text x="64" y="133" class="c26-scene-label">BID SCOPES</text>
                  <text x="282" y="133" class="c26-scene-label">BUYOUT RECORD</text>
                </svg>
                <p>Could the team compare scope, exclusions, alternates, and revisions before award?</p>
              </article>
              <article class="c26-workflow-lane">
                <h3>Change and risk capture</h3>
                <svg viewBox="0 0 340 142" aria-hidden="true">
                  <defs><marker id="c26-change-arrow" viewBox="0 0 10 10" refX="7.5" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#191e26" /></marker></defs>
                  <path d="M18 34 h82 v72 h-82 z M18 34 l18-14 h46 l18 14 M29 89 l20-22 13 14 13-12 15 20" class="c26-scene-line" />
                  <circle cx="78" cy="53" r="7" class="c26-scene-line" />
                  <path d="M116 68 H148 M192 68 H226" class="c26-flow-line" marker-end="url(#c26-change-arrow)" />
                  <text x="170" y="87" class="c26-gap-label"><tspan x="170">SOURCE + OWNER</tspan><tspan x="170" dy="12">+ EFFECT?</tspan></text>
                  <path d="M242 26 h78 v82 h-78 z M254 48 h54 M254 66 h40 M254 84 h48" class="c26-scene-line" />
                  <circle cx="306" cy="89" r="6" class="c26-status-dot" />
                  <text x="59" y="133" class="c26-scene-label">FIELD SIGNAL</text>
                  <text x="281" y="133" class="c26-scene-label">CHANGE RECORD</text>
                </svg>
                <p>Could the right person see the source, owner, status, and possible cost or schedule effect in time to decide what happened next?</p>
              </article>
          </div>
        </figure>
      </div>
    </section>

    <section class="c26-loopband" aria-labelledby="loop-title">
      <div class="c26-inner c26-split">
        <div class="c26-copy">
          <h2 id="loop-title">Give the next phase a better starting point.</h2>
          <p>A usable handoff, buyout, or change record helps the next person see what was agreed, what changed, what is still open, and who owns the next decision.</p>
          <a class="c26-cta" href="#tell-me" data-track="cta:construction-loop">Make the next handoff clearer</a>
        </div>

        <figure class="c26-board" aria-labelledby="trace-board-title-two" aria-describedby="loop-description">
          <figcaption id="trace-board-title-two" class="c26-bar">A commercial GC project lifecycle</figcaption>
          <p id="loop-description" class="c26-sr-only">Estimate, project handoff, buyout, build and manage changes, then closeout and learn. One usable project record carries decisions into each phase.</p>
          <div class="c26-loop-visual">
            <svg viewBox="0 0 660 420" role="img" aria-hidden="true">
              <defs>
                <marker id="c26-loop-arrow" viewBox="0 0 10 10" refX="7.5" refY="5" markerWidth="7" markerHeight="7" orient="auto">
                  <path d="M0,0 L10,5 L0,10 z" fill="#191e26" />
                </marker>
              </defs>
              <path d="M408 70 Q500 78 526 136" class="c26-loop-arrow" marker-end="url(#c26-loop-arrow)" />
              <path d="M542 208 Q536 266 472 302" class="c26-loop-arrow" marker-end="url(#c26-loop-arrow)" />
              <path d="M398 348 H264" class="c26-loop-arrow" marker-end="url(#c26-loop-arrow)" />
              <path d="M188 304 Q118 276 108 220" class="c26-loop-arrow" marker-end="url(#c26-loop-arrow)" />
              <path d="M118 138 Q150 82 252 70" class="c26-loop-arrow" marker-end="url(#c26-loop-arrow)" />
              <g><rect x="246" y="26" width="168" height="70" rx="12" /><text x="330" y="68" class="c26-loop-word">Estimate</text></g>
              <g><rect x="466" y="140" width="176" height="70" rx="12" /><text x="554" y="168" class="c26-loop-word"><tspan x="554">Project</tspan><tspan x="554" dy="21">handoff</tspan></text></g>
              <g><rect x="400" y="304" width="160" height="70" rx="12" /><text x="480" y="346" class="c26-loop-word">Buyout</text></g>
              <g><rect x="102" y="304" width="170" height="70" rx="12" /><text x="187" y="332" class="c26-loop-word"><tspan x="187">Build + manage</tspan><tspan x="187" dy="21">changes</tspan></text></g>
              <g><rect x="18" y="140" width="180" height="70" rx="12" /><text x="108" y="168" class="c26-loop-word"><tspan x="108">Closeout</tspan><tspan x="108" dy="21">+ learn</tspan></text></g>
              <g><rect x="242" y="174" width="176" height="70" rx="10" class="c26-loop-center" /><text x="330" y="202" class="c26-loop-center-text"><tspan x="330">ONE PROJECT</tspan><tspan x="330" dy="20">RECORD</tspan></text></g>
            </svg>
          </div>
          <p class="c26-board-cap">Each phase leaves the next one a usable record to work from.</p>
        </figure>
      </div>
    </section>

    <section class="c26-finale" aria-labelledby="finale-title">
      <div class="c26-img-holder">
        <picture>
          <source
            media="(min-width: 1021px)"
            type="image/webp"
            srcset="/home/austin-portrait-desktop-1200.webp 1200w, /home/austin-portrait-desktop-1600.webp 1600w, /home/austin-portrait-desktop-2000.webp 2000w, /home/austin-portrait-desktop-2400.webp 2400w, /home/austin-portrait-desktop-2880.webp 2880w, /home/austin-portrait-desktop-3200.webp 3200w, /home/austin-portrait-desktop-3600.webp 3600w"
            sizes="100vw"
          />
          <source media="(min-width: 1021px)" type="image/jpeg" srcset="/home/austin-portrait-desktop.jpg" />
          <source
            type="image/webp"
            srcset="/home/austin-portrait-900.webp 900w, /home/austin-portrait-1200.webp 1200w, /home/austin-portrait-1600.webp 1600w, /home/austin-portrait-2200.webp 2200w, /home/austin-portrait-2880.webp 2880w"
            sizes="100vw"
          />
          <img
            src="/home/austin-portrait.jpg"
            width="1600"
            height="1067"
            alt="Jonathan Malkin speaking onstage in Austin."
            loading="lazy"
          />
        </picture>
      </div>
      <div class="c26-over">
        <h2 id="finale-title">Resolve the workflow before it repeats.</h2>
        <p>Bring one recent example: what happened, where the details lived, and what should have gone differently. I reply personally. If I can help, the next step is a call.</p>
        <a class="c26-cta" href="#tell-me" data-track="cta:construction-final">Bring me the stuck workflow</a>
      </div>
    </section>

    <section class="c26-intake" id="tell-me" aria-labelledby="tellme-h">
      <div class="c26-inner">
        <h2 id="tellme-h">Share one recent example.</h2>
        <div class="c26-formboard">
          <div class="c26-bar">Short intake</div>
          <div class="c26-formwrap">
            <form action="/api/subscribe" method="POST" class="intake bm-step1" data-track-form="business-map">
              <p class="intake-progress">Step 1 of 2 &middot; Email first</p>
              <input type="hidden" name="_subject" value="Construction website intake (step 1)" />
              <input type="hidden" name="inquiry_type" value="business-map-intake" />
              <input type="hidden" name="form_id" value="business-map" />
              <input type="hidden" name="framing" value="construction" />
              <input type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" class="form-honeypot" />
              <div class="form-group">
                <label for="c26-email">Email</label>
                <input type="email" id="c26-email" name="email" required class="form-input" autocomplete="email" inputmode="email" spellcheck="false" />
                <p class="intake-hint">Three questions follow so I can give you a useful reply.</p>
              </div>
              <div class="form-group">
                <label for="c26-name">Name <span class="form-optional">(optional)</span></label>
                <input type="text" id="c26-name" name="name" class="form-input" autocomplete="name" />
              </div>
              <button type="submit" class="form-submit">Continue to the questions</button>
              <p class="intake-status" hidden role="status"></p>
            </form>

            <template id="bm-step2-template">
              <form action="/api/subscribe" method="POST" class="intake bm-step2" data-track-form="business-map-details">
                <p class="intake-done" role="status">Got it. Three questions and you're done.</p>
                <p class="intake-progress">Step 2 of 2 &middot; Three questions</p>
                <input type="hidden" name="_subject" value="Construction website intake (step 2)" />
                <input type="hidden" name="inquiry_type" value="business-map-intake" />
                <input type="hidden" name="form_id" value="business-map-details" />
                <input type="hidden" name="framing" value="construction" />
                <input type="hidden" name="email" value="" />
                <input type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" class="form-honeypot" />
                <div class="form-group">
                  <label for="c26-blocked-project">What keeps breaking down or taking longer than it should?</label>
                  <textarea id="c26-blocked-project" name="blocked_project" rows="3" required maxlength="2000" class="form-input"></textarea>
                </div>
                <fieldset class="form-group">
                  <legend>Does one person know where most of the information lives?</legend>
                  <div class="yesno">
                    <label><input type="radio" name="key_person" value="Yes" required /> Yes</label>
                    <label><input type="radio" name="key_person" value="No" /> No</label>
                  </div>
                </fieldset>
                <fieldset class="form-group">
                  <legend>Is anyone on your team already fixing it?</legend>
                  <div class="yesno">
                    <label><input type="radio" name="already_building" value="Yes" required /> Yes</label>
                    <label><input type="radio" name="already_building" value="No" /> No</label>
                  </div>
                </fieldset>
                <button type="submit" class="form-submit">Send the intake</button>
                <p class="intake-status" hidden role="status"></p>
              </form>
            </template>
            <div class="bm-step2-slot"></div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  const step1 = document.querySelector('.bm-step1');
  const step2Template = document.getElementById('bm-step2-template');
  const step2Slot = document.querySelector('.bm-step2-slot');

  function statusEl(form) {
    return form.querySelector('.intake-status');
  }

  function showStatus(form, message) {
    const status = statusEl(form);
    if (status) {
      status.textContent = message;
      status.hidden = false;
    }
  }

  async function submitIntake(form) {
    const response = await fetch(form.action, {
      method: 'POST',
      body: new FormData(form),
      headers: { Accept: 'application/json' },
    });
    const result = await response.json().catch(() => ({}));
    if (!response.ok || !result.ok) throw new Error(result.error || 'intake_failed');
    return result;
  }

  function wireStep2(email) {
    if (!step2Template || !step2Slot || step2Slot.querySelector('form')) return;
    step2Slot.appendChild(step2Template.content.cloneNode(true));
    const step2 = step2Slot.querySelector('.bm-step2');
    if (!step2) return;
    const emailField = step2.querySelector('input[name="email"]');
    if (emailField) emailField.value = email;
    if (window.bwjInjectAttribution) window.bwjInjectAttribution(step2Slot);

    step2.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!step2.checkValidity()) {
        step2.reportValidity();
        return;
      }
      const button = step2.querySelector('button[type="submit"]');
      if (button) {
        button.disabled = true;
        button.textContent = 'Sending...';
      }
      try {
        await submitIntake(step2);
        if (window.bwjTrack) window.bwjTrack('business-map:success');
        step2.querySelectorAll('.form-group, button[type="submit"], .intake-progress, .intake-done').forEach((el) => {
          el.hidden = true;
        });
        showStatus(step2, 'Got it. I will reply to the email you gave me.');
      } catch (err) {
        showStatus(step2, 'That did not go through. Email jonathan@builtwithjon.com and I will follow up.');
        if (button) {
          button.disabled = false;
          button.textContent = 'Send the intake';
        }
      }
    });

    step2.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    const firstField = step2.querySelector('textarea');
    if (firstField) firstField.focus({ preventScroll: true });
  }

  step1?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!step1.checkValidity()) {
      step1.reportValidity();
      return;
    }
    const button = step1.querySelector('button[type="submit"]');
    if (button) {
      button.disabled = true;
      button.textContent = 'Saving...';
    }
    try {
      await submitIntake(step1);
      if (window.bwjTrack) window.bwjTrack('business-map:capture');
      const email = step1.querySelector('input[name="email"]')?.value || '';
      step1.hidden = true;
      wireStep2(email);
    } catch (err) {
      showStatus(step1, 'That did not go through. Email jonathan@builtwithjon.com and I will follow up.');
      if (button) {
        button.disabled = false;
        button.textContent = 'Continue to the questions';
      }
    }
  });
</script>

<style>
  .c26-construction {
    --ink: #191e26;
    --body: #3f4752;
    --caption: #5c6570;
    --ivory: #fbf8f1;
    --parchment: #f3ecdd;
    --amber: #e8a83c;
    --amber-soft: #f2ce8a;
    --red: #c4392b;
    --display: 'Bricolage Grotesque Variable', sans-serif;
    --text: 'Schibsted Grotesk Variable', sans-serif;
    color: var(--ink);
    background: var(--ivory);
    font-family: var(--text);
    text-align: left;
  }

  .c26-construction *,
  .c26-construction *::before,
  .c26-construction *::after { box-sizing: border-box; }
  .c26-construction img { display: block; max-width: 100%; }
  .c26-construction h1,
  .c26-construction h2,
  .c26-construction h3 { color: var(--ink); font-family: var(--display); letter-spacing: -.02em; }
  .c26-inner { width: min(1280px, 90vw); margin-inline: auto; }

  .c26-cta {
    display: inline-block;
    border-radius: 6px;
    background: var(--ink);
    color: var(--ivory);
    padding: 18px 28px;
    font: 600 1.05rem/1 var(--text);
    text-align: center;
    text-decoration: none;
  }
  .c26-cta:hover { color: var(--ivory); text-decoration: none; }
  .c26-cta:focus-visible { outline: 3px solid var(--ink); outline-offset: 4px; }

  .c26-hero,
  .c26-finale { position: relative; height: 620px; overflow: hidden; }
  .c26-img-holder { position: absolute; inset: 0; }
  .c26-img-holder img { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; }
  .c26-hero img { object-position: 50% 42%; }
  .c26-finale img { object-position: 50% 44%; }
  .c26-over {
    position: absolute;
    left: 5vw;
    bottom: 44px;
    z-index: 2;
    width: min(570px, 42vw);
    border-radius: 14px;
    background: var(--ivory);
    padding: 38px 40px;
    box-shadow: 0 30px 80px -40px rgba(0,0,0,.55);
  }
  .c26-hero h1 { max-width: 15ch; margin: 0 0 14px; font-size: clamp(2.3rem, 4.3vw, 3.5rem); font-weight: 700; line-height: 1.04; }
  .c26-lede { max-width: 58ch; margin: 0 0 22px; color: var(--body); font-size: 1.16rem; line-height: 1.48; }

  .c26-loopband { background: var(--parchment); padding: 82px 0 92px; }
  .c26-split { display: grid; grid-template-columns: minmax(0, .8fr) minmax(540px, 1.2fr); gap: clamp(48px, 6vw, 84px); align-items: center; }
  .c26-copy h2 { max-width: 15ch; margin: 0 0 18px; font: 700 clamp(2rem, 3.4vw, 3rem)/1.04 var(--display); letter-spacing: -.02em; }
  .c26-copy > p { max-width: 46ch; margin: 0 0 26px; color: var(--body); font-size: 1.14rem; line-height: 1.6; }

  .c26-board,
  .c26-workflow-board,
  .c26-formboard { overflow: hidden; margin: 0; border: 1.5px solid var(--ink); border-radius: 16px; background: var(--ivory); box-shadow: 8px 14px 0 var(--ink); }
  .c26-bar { margin: 0; background: var(--ink); color: var(--ivory); padding: 13px 18px; font: 700 12px/1 var(--text); letter-spacing: .14em; text-transform: uppercase; }
  .c26-workflow-lane svg,
  .c26-loop-visual svg { display: block; width: 100%; height: auto; }
  .c26-loop-visual g > rect:not(.c26-loop-center) { fill: var(--parchment); stroke: var(--ink); stroke-width: 1.6; }
  .c26-scene-line { fill: none; stroke: var(--ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .c26-flow-line,
  .c26-loop-arrow { fill: none; stroke: var(--ink); stroke-width: 2.4; }
  .c26-loop-word { fill: var(--ink); font-family: var(--display); font-weight: 700; }
  .c26-scene-label { fill: var(--body); font: 700 11px var(--text); text-anchor: middle; }
  .c26-gap-label { fill: var(--red); font: 800 10.5px var(--text); letter-spacing: .01em; text-anchor: middle; }
  .c26-board-cap { margin: 0; padding: 0 26px 22px; color: var(--caption); font-size: .94rem; line-height: 1.45; }
  .c26-sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }

  .c26-proof { background: var(--amber); padding: 82px 0 92px; }
  .c26-workflow-board { background: var(--ivory); }
  .c26-workflow-list { display: grid; }
  .c26-workflow-lane { display: grid; grid-template-columns: minmax(210px, .72fr) minmax(300px, 1fr) minmax(300px, 1.08fr); gap: clamp(24px, 3vw, 44px); align-items: center; border-bottom: 1.5px solid var(--ink); padding: 26px 30px 28px; }
  .c26-workflow-lane h3 { margin: 0; font-size: 1.35rem; line-height: 1.2; }
  .c26-workflow-lane p { margin: 0; color: var(--body); font-size: .96rem; line-height: 1.52; }
  .c26-flow-line { stroke-dasharray: 8 6; }
