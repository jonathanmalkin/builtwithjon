---
// Shared site footer, October 2026. Ink ground so the page has a clear end
// (the last band above it is usually parchment), the light one-line logo, the
// four pages set large, the quieter links beside them, then a legal row.
// Carries its own styles so it renders the same on pages that do not load the
// body.odl world.
import { NAV, SITE, SOCIAL } from '../data/odl';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/schibsted-grotesk';

const year = new Date().getFullYear();
const more = [
  { href: '/making-ai-useful/', label: 'Making AI useful' },
  { href: '/faq/', label: 'Common questions' },
  { href: '/contact/', label: 'Contact' },
];
---

<footer class="odl-footer">
  <div class="odl-footer-inner">
    <div class="odl-footer-brand">
      <a href="/" aria-label="Open Door Learning, home"><img src="/brand/odl-logo-one-line-light.svg" alt="Open Door Learning" width="806" height="144" loading="lazy" /></a>
      <p>Hands-on AI workshops for owners, executives and their teams. {SITE.person}, {SITE.city}.</p>
    </div>
    <nav class="odl-footer-nav" aria-label="Footer">
      <ul class="odl-footer-main">
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
      <ul class="odl-footer-more">
        {more.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="odl-footer-legal">
    <p>&copy; {year} {SITE.legal}</p>
    <ul>
      {SOCIAL.map((s) => <li><a href={s.href} rel="me">{s.label}</a></li>)}
      <li><a href="/articles/">Articles</a></li>
      <li><a href="/rss.xml">RSS</a></li>
      <li><a href="/privacy/">Privacy</a></li>
      <li><a href="/terms/">Terms</a></li>
    </ul>
  </div>
</footer>

<style>
  .odl-footer {
    --f-ink: #191E26;
    --f-ivory: #FBF7EE;
    --f-soft: #C9C2B3;
    --f-line: rgba(251, 247, 238, .16);
    --f-amber: #E8A83C;
    background: var(--f-ink);
    color: var(--f-ivory);
    font-family: 'Schibsted Grotesk Variable', sans-serif;
    font-size: 1rem;
    line-height: 1.5;
    margin-top: 0;
    padding: 0;
  }
  :global(body:not(.odl)) .odl-footer { width: 100vw; margin-left: calc(50% - 50vw); margin-top: 3rem; }
  .odl-footer ul { list-style: none; margin: 0; padding: 0; }
  .odl-footer a { color: inherit; text-decoration: none; }
  .odl-footer a:hover { color: var(--f-amber); }
  .odl-footer :focus-visible { outline: 3px solid var(--f-amber); outline-offset: 4px; border-radius: 3px; }
  .odl-footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 40px clamp(24px, 4vw, 64px);
    align-items: start;
    padding: clamp(48px, 6vw, 80px) max(5vw, calc((100% - 1240px) / 2)) clamp(40px, 5vw, 64px);
  }
  .odl-footer-brand img { display: block; height: 44px; width: auto; margin-bottom: 20px; }
  .odl-footer-brand p { margin: 0; color: var(--f-soft); max-width: 34ch; }
  .odl-footer-nav { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 32px clamp(24px, 4vw, 64px); }
  .odl-footer-main { display: grid; gap: 0; }
  .odl-footer-main a {
    display: inline-block;
    padding: 9px 0;
    font: 600 clamp(1.5rem, 2.4vw, 2rem)/1.15 'Bricolage Grotesque Variable', 'Schibsted Grotesk Variable', sans-serif;
    letter-spacing: -.02em;
  }
  .odl-footer-more { display: grid; gap: 0; align-content: start; padding-top: 4px; }
  .odl-footer-more a { display: inline-block; padding: 10px 0; font-weight: 550; color: var(--f-soft); }
  .odl-footer-legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 4px 32px;
    margin: 0 max(5vw, calc((100% - 1240px) / 2));
    padding: 12px 0 20px;
    border-top: 1px solid var(--f-line);
    font-size: .92rem;
    color: var(--f-soft);
  }
  .odl-footer-legal p { margin: 0; color: var(--f-soft); }
  .odl-footer-legal ul { display: flex; flex-wrap: wrap; gap: 0 22px; }
  /* Side padding widens the tap area of short labels such as X without moving them. */
  .odl-footer-legal a { display: inline-block; padding: 11px 8px; margin: 0 -8px; }
  @media (max-width: 760px) {
    .odl-footer-inner { grid-template-columns: 1fr; }
    .odl-footer-nav { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
