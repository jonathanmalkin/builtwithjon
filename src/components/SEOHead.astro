---
interface Props {
  title: string;
  description: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  article?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og-default.png',
  imageWidth,
  imageHeight,
  article = false,
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const siteName = 'Open Door Learning';
const isDefaultImage = image === '/og-default.png';
// The two site share images are 1200 by 630. Any other image states its size
// only when the page passes it, so the tags never claim the wrong one.
const knownSize = isDefaultImage || image === '/og-workshops.jpg';
const ogWidth = imageWidth ?? (knownSize ? 1200 : undefined);
const ogHeight = imageHeight ?? (knownSize ? 630 : undefined);
// Long descriptions end at the last whole sentence that fits, so snippets read
// as finished thoughts. The word cut with an ellipsis is the fallback when no
// sentence boundary lands in a useful range.
const lastSentenceEnd = Math.max(
  ...['. ', '! ', '? '].map((mark) => description.slice(0, 161).lastIndexOf(mark)),
);
const metaDescription = description.length <= 160
  ? description
  : lastSentenceEnd >= 70
    ? description.slice(0, lastSentenceEnd + 1)
    : `${description.slice(0, 157).replace(/\s+\S*$/, '')}…`;
---

{!noindex && <link rel="canonical" href={canonicalURL} />}
<meta name="description" content={metaDescription} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={metaDescription} />
<meta property="og:site_name" content={siteName} />
{image && <meta property="og:image" content={imageURL} />}
{image && ogWidth && <meta property="og:image:width" content={ogWidth} />}
{image && ogHeight && <meta property="og:image:height" content={ogHeight} />}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter/X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@builtwithjon" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={metaDescription} />
{image && <meta name="twitter:image" content={imageURL} />}
