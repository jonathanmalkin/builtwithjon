---
import { CONTACT, smsLink } from '../data/contact-card.js';
interface Props { subject: string; inquiryType: string; label?: string; }
const { inquiryType } = Astro.props;
const preview = import.meta.env.CONTACT_PREVIEW === 'true';
---
<div class="exchange-page">
  {preview && <p class="exchange-preview">Test preview. Texting and saving my contact work. Form delivery starts after launch.</p>}
  <header class="exchange-identity">
    <img src="/images/jonathan-malkin.jpg" width="88" height="88" alt="Jonathan Malkin" />
    <div><p class="exchange-label">Built with Jon</p><h1>Jonathan Malkin</h1><p>Austin, Texas</p></div>
  </header>
  <section class="exchange-primary" aria-label="Start a conversation">
    <h2>Let’s stay in touch.</h2>
    <a class="exchange-button exchange-button-primary" data-sms-link href={smsLink()}>Text Jonathan</a>
    <p class="exchange-hint">Add your name and where we met, then tap Send.</p>
    <a class="exchange-button" href="/jonathan-malkin.vcf">Save my contact</a>
    <p class="exchange-number">{CONTACT.displayPhone}</p>
  </section>
  <details class="exchange-details">
    <summary>Share your contact details</summary>
    <p>Leave your details here if you’d rather skip the text.</p>
    <form action={preview ? undefined : '/api/contact'} method="POST" class="exchange-form" data-preview={preview ? 'true' : undefined}>
      <input type="hidden" name="inquiry_type" value={inquiryType} />
      <input type="hidden" name="submission_id" value="" />
      <input type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" class="exchange-honeypot" />
      <label for="exchange-name">Your name<input id="exchange-name" name="name" autocomplete="name" required maxlength="120" /></label>
      <label for="exchange-phone">Mobile number<input id="exchange-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required maxlength="32" placeholder="512-555-0123" /></label>
      <label for="exchange-email">Email <span>(optional)</span><input id="exchange-email" name="email" type="email" autocomplete="email" maxlength="254" /></label>
      <label for="exchange-context">Where we met / what we discussed <span>(optional)</span><textarea id="exchange-context" name="message" rows="2" maxlength="2000"></textarea></label>
      <details class="exchange-more"><summary>More details</summary>
        <label for="exchange-company">Company <span>(optional)</span><input id="exchange-company" name="company" autocomplete="organization" maxlength="160" /></label>
        <label for="exchange-linkedin">LinkedIn profile <span>(optional)</span><input id="exchange-linkedin" name="linkedin" type="url" placeholder="https://www.linkedin.com/in/your-name" maxlength="300" /></label>
      </details>
      <button type="submit" class="exchange-button exchange-button-primary">{preview ? 'Check my details' : 'Share my details'}</button>
      <p class="exchange-hint">For staying in touch. This does not sign you up for marketing emails.</p>
      <p class="exchange-status" role="status" tabindex="-1" hidden></p>
    </form>
  </details>
  <footer class="exchange-footer"><a href={CONTACT.linkedin} rel="me noopener" target="_blank">LinkedIn</a><a href={`mailto:${CONTACT.email}`}>Email Jonathan</a></footer>
</div>
<script>
  import { INTRO_TEXT, smsLink } from '../data/contact-card.js';
  import { normalizePhone, validLinkedIn } from '../lib/scan-contact.js';
  const apple = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const textLink = document.querySelector<HTMLAnchorElement>('[data-sms-link]');
  if (textLink) textLink.href = smsLink(INTRO_TEXT, apple);
  const form = document.querySelector<HTMLFormElement>('.exchange-form');
  const status = form?.querySelector<HTMLParagraphElement>('.exchange-status');
  const phone = form?.querySelector<HTMLInputElement>('[name="phone"]');
  const linkedin = form?.querySelector<HTMLInputElement>('[name="linkedin"]');
  const submission = form?.querySelector<HTMLInputElement>('[name="submission_id"]');
  if (submission) submission.value = crypto.randomUUID();
  phone?.addEventListener('input', () => phone.setCustomValidity(''));
  linkedin?.addEventListener('input', () => linkedin.setCustomValidity(''));
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!phone || !status) return;
    phone.setCustomValidity(normalizePhone(phone.value) ? '' : 'Enter a valid mobile number, including the country code outside the US or Canada.');
    linkedin?.setCustomValidity(!linkedin.value || validLinkedIn(linkedin.value) ? '' : 'Use a LinkedIn profile URL such as https://www.linkedin.com/in/your-name.');
    if (!form.reportValidity()) return;
    if (form.dataset.preview === 'true') {
      status.textContent = 'Your details pass validation. Nothing was submitted in this preview.';
      status.hidden = false;
      return;
    }
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    try {
      const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const result = await response.json();
      if (!response.ok || !result.stored) throw new Error('not_saved');
      status.textContent = 'Your details are saved. You can text me above to start a conversation.';
      form.querySelectorAll<HTMLInputElement | HTMLButtonElement | HTMLTextAreaElement>('input, button, textarea').forEach(el => el.disabled = true);
    } catch {
      status.textContent = 'That did not go through. Your details are still here. Try again or text me above.';
      if (button) button.disabled = false;
      const widget = form.dataset.turnstileWidget;
      if (widget && (window as any).turnstile) (window as any).turnstile.reset(widget);
    }
    status.hidden = false;
    status.focus();
  });
</script>
