---
import { Icon } from 'astro-icon/components';
import { CONTACT, smsLink, emailLink, FALLBACK_TEXT } from '../data/contact-card.js';
interface Props { subject: string; inquiryType: string; label?: string; }
const { inquiryType } = Astro.props;
const preview = import.meta.env.CONTACT_PREVIEW === 'true';
---
<div class="exchange-page" data-exchange>
  {preview && <p class="exchange-preview">Preview. Try the form, then open a text. Nothing you enter is submitted.</p>}
  <header class="exchange-identity">
    <img src="/images/jonathan-malkin.jpg" width="88" height="88" alt="Jonathan Malkin" />
    <div><p class="exchange-name">Jonathan Malkin</p><p class="exchange-byline">Built with Jon · Austin, Texas</p></div>
  </header>
  <section class="exchange-task" data-exchange-entry aria-labelledby="exchange-title">
    <h1 id="exchange-title">Let’s stay in touch.</h1>
    <p class="exchange-intro">Add your info, then send me a quick text.</p>
    <form action={preview ? undefined : '/api/contact'} method="POST" class="exchange-form" data-security-owner="exchange" data-preview={preview ? 'true' : undefined} data-site-key="0x4AAAAAAEJkiadExu7m9ULG">
      <input type="hidden" name="inquiry_type" value={inquiryType} />
      <input type="hidden" name="submission_id" value="" />
      <input type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" class="exchange-honeypot" />
      <div class="exchange-field">
        <label for="exchange-name">Your name</label>
        <input id="exchange-name" name="name" autocomplete="name" required maxlength="120" />
      </div>
      <div class="exchange-field">
        <label for="exchange-phone">Mobile number</label>
        <input id="exchange-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="32" aria-describedby="exchange-reach-hint" />
        <p id="exchange-reach-hint" class="exchange-hint">Mobile or email works. Mobile is faster for a text.</p>
      </div>
      <div class="exchange-field">
        <label for="exchange-email">Email</label>
        <input id="exchange-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" aria-describedby="exchange-reach-hint" />
      </div>
      <div class="exchange-field">
        <label for="exchange-context" class="exchange-label-optional">Where we met <em>(optional)</em></label>
        <input id="exchange-context" name="message" maxlength="2000" autocomplete="off" />
      </div>
      <div class="exchange-security" data-security-wrap hidden>
        <p data-security-status role="status">Checking your connection…</p>
        <div data-security-widget></div>
        <button type="button" class="exchange-link-button" data-security-retry hidden>Retry the check</button>
      </div>
      <button type="submit" class="exchange-button exchange-button-primary" disabled>{preview ? 'Try sharing my details' : 'Share my details'}</button>
      <p class="exchange-assurance">Only I see this, and only to stay in touch. No marketing emails.</p>
      <p class="exchange-status" role="alert" aria-live="assertive" tabindex="-1" hidden></p>
      <noscript><p class="exchange-hint">To share details here, turn on JavaScript. You can also text me below.</p></noscript>
    </form>
  </section>
  <section class="exchange-success" data-exchange-success aria-labelledby="exchange-saved-title" hidden>
    <Icon name="lucide:check" class="exchange-check" aria-hidden="true" />
    <h1 id="exchange-saved-title" tabindex="-1">{preview ? 'That’s how it works.' : 'Got it. Thanks!'}</h1>
    <p class="exchange-intro" data-saved-intro>{preview ? 'Nothing was submitted. The text and contact links below still work.' : 'Saved. Now send me a quick text so you’re in my phone too.'}</p>
    <div class="exchange-next" data-next-sms>
      <a class="exchange-button exchange-button-primary" data-sms-next href={smsLink(FALLBACK_TEXT)}><Icon name="lucide:message-circle" aria-hidden="true" />Text Jonathan</a>
      <p class="exchange-assurance">Your messaging app opens with a note ready. You tap Send. <button type="button" class="exchange-inline-button" data-copy-note>Note missing? Copy it.</button></p>
    </div>
    <div class="exchange-next" data-next-email hidden>
      <a class="exchange-button exchange-button-primary" data-email-next href={emailLink()}><Icon name="lucide:mail" aria-hidden="true" />Email Jonathan</a>
      <p class="exchange-assurance">Your mail app opens with a note ready. You tap Send.</p>
    </div>
    <p class="exchange-assurance exchange-desktop-note">On a phone, text me at <strong>{CONTACT.displayPhone}</strong>. Or <a data-email-next href={emailLink()}>send an email</a>.</p>
    <p class="exchange-copy-status" role="status" hidden></p>
    <a class="exchange-button exchange-button-secondary" href="/jonathan-malkin.vcf"><Icon name="lucide:user-round-plus" aria-hidden="true" />Save Jonathan’s contact</a>
    <p class="exchange-assurance">Opens a contact card with my number and email. You tap Add.</p>
  </section>
  <footer class="exchange-footer">
    <div class="exchange-actions">
      <a class="exchange-action exchange-before-save" href="/jonathan-malkin.vcf"><Icon name="lucide:user-round-plus" aria-hidden="true" />Save my contact</a>
      <a class="exchange-action exchange-before-save exchange-phone-only" data-sms-fallback href={smsLink(FALLBACK_TEXT)}><Icon name="lucide:message-circle" aria-hidden="true" />Text me instead</a>
      <a class="exchange-action exchange-before-save exchange-desktop-note" href={emailLink()}><Icon name="lucide:mail" aria-hidden="true" />Email me instead</a>
    </div>
    <p class="exchange-footnote exchange-before-save">Texting or emailing first? Add your name so I know it’s you.</p>
  </footer>
</div>
<script>
  import '../scripts/contact-exchange';
</script>
