---
// Shared site header, October 2026: the one-line Open Door Learning logo and
// the five-page navigation. Carries its own styles so it renders the same on
// pages that do not load the body.odl world.
import { NAV } from '../data/odl';
import '@fontsource-variable/schibsted-grotesk';

const pathname = Astro.url.pathname;
const current = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header class="odl-header">
  <div class="odl-header-inner">
    <a class="odl-logo" href="/" aria-label="Open Door Learning, home">
      <img src="/brand/odl-logo-one-line.svg" alt="Open Door Learning" width="308" height="55" />
    </a>
    <button class="odl-menu" type="button" aria-expanded="false" aria-controls="odl-nav" hidden>
      <span class="odl-menu-label">Menu</span>
      <svg class="odl-menu-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      <svg class="odl-menu-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <nav class="odl-nav" id="odl-nav" aria-label="Main">
      {NAV.map((item) => (
        <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.odl-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.odl-menu');
  const nav = header?.querySelector<HTMLElement>('.odl-nav');
  if (header && toggle && nav) {
    header.classList.add('has-js');
    toggle.hidden = false;
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      header.classList.toggle('open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    // Close when the visitor moves on: a tap outside, or focus leaving the header.
    document.addEventListener('pointerdown', (event) => {
      if (toggle.getAttribute('aria-expanded') === 'true' && event.target instanceof Node && !header.contains(event.target)) setOpen(false);
    });
    header.addEventListener('focusout', (event) => {
      const next = event.relatedTarget;
      if (toggle.getAttribute('aria-expanded') === 'true' && next instanceof Node && !header.contains(next)) setOpen(false);
    });
  }
</script>

<style>
  .odl-header {
    --h-ink: #191E26;
    --h-ivory: #FBF8F1;
    --h-line: #D2C4A6;
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--h-ivory);
    border-bottom: 1px solid var(--h-line);
    font-family: 'Schibsted Grotesk Variable', sans-serif;
    color: var(--h-ink);
  }
  /* Older pages constrain <body>; the header still spans the viewport. */
  :global(body:not(.odl)) .odl-header { width: 100vw; margin-left: calc(50% - 50vw); }
  .odl-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 12px max(5vw, calc((100% - 1240px) / 2));
  }
  .odl-logo { display: inline-flex; border-radius: 4px; }
  .odl-logo img { display: block; height: 44px; width: auto; }
  .odl-nav { display: flex; gap: clamp(14px, 2.2vw, 30px); }
  .odl-nav a {
    font-family: inherit;
    font-weight: 550;
    font-size: 1rem;
    line-height: 1;
    color: var(--h-ink);
    text-decoration: none;
    padding: 10px 0;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }
  .odl-nav a:hover { border-bottom-color: var(--h-ink); }
  .odl-nav a[aria-current='page'] { border-bottom-color: #8F4E24; }
  .odl-menu {
    display: none;
    align-items: center;
    gap: 8px;
    font-family: inherit;
    font-weight: 600;
    font-size: .95rem;
    line-height: 1;
    color: var(--h-ink);
    background: none;
    border: 1.5px solid var(--h-ink);
    border-radius: 6px;
    padding: 10px 12px;
    cursor: pointer;
    min-height: 44px;
  }
  .odl-menu-close { display: none; }
  .open .odl-menu-close { display: block; }
  .open .odl-menu-open { display: none; }
  .odl-header :focus-visible { outline: 3px solid var(--h-ink); outline-offset: 3px; border-radius: 3px; }

  @media (max-width: 860px) {
    .odl-logo img { height: 36px; }
  }
  @media (max-width: 720px) {
    .odl-header-inner { flex-wrap: wrap; gap: 8px 16px; padding: 12px 5vw; }
    .odl-nav a { padding: 14px 0; }
    .odl-nav { width: 100%; flex-wrap: wrap; gap: 0 22px; padding: 4px 0 2px; }
    .has-js .odl-menu { display: inline-flex; }
    .has-js .odl-nav { display: none; }
    .has-js.open .odl-nav { display: flex; flex-direction: column; gap: 0; padding: 8px 0 10px; border-top: 1px solid var(--h-line); margin-top: 6px; }
    .has-js.open .odl-nav a { padding: 14px 0; font-size: 1.1rem; border-bottom: 1px solid var(--h-line); }
    .has-js.open .odl-nav a:last-child { border-bottom-color: transparent; }
    .has-js.open .odl-nav a[aria-current='page'] { border-bottom-color: var(--h-line); color: #8F4E24; }
  }
  /* The narrowest phones: keep the logo and Menu on one row. */
  @media (max-width: 359px) {
    .odl-logo img { height: 30px; }
  }
  /* Short screens (a phone on its side, heavy zoom): the header scrolls away. */
  @media (max-height: 420px) {
    .odl-header { position: static; }
  }
  @media (min-width: 721px) {
    .odl-nav a { padding: 13px 0; }
  }
</style>
